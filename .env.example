APP_NAME="FormEzy ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8731

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=industrial_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Imports (Masters → Geography → Import) run as queued jobs. In production keep "database" (or redis) and run
# `php artisan queue:work` under a supervisor; for local development "sync" runs them inline with no worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mobile API (/api/v1). Device tokens last this many minutes (20160 = 14 days) and a person may have this many devices signed in.
API_TOKEN_TTL_MINUTES=20160
API_MAX_DEVICES=5
# Browser origins allowed to call the API from another host, comma separated (e.g. https://app.example.com). Empty = none.
API_CORS_ORIGINS=

VITE_APP_NAME="${APP_NAME}"

# Database backups (php artisan formezy:backup). Turn on in production; give the full path of the two programs if they are not on the PATH.
BACKUP_ENABLED=false
BACKUP_KEEP=14
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql
