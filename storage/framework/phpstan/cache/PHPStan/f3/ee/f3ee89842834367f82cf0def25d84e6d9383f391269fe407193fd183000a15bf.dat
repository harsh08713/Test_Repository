O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-4906a026a7b1df99f88397e963ae956b265476e8405e17252bdbbb49ccb6af32";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\CRM\Services\RoutePlanService";s:8:"filename";s:76:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/RoutePlanService.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:41:"App\Modules\CRM\Services\RoutePlanService";s:9:"shortName";s:16:"RoutePlanService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1487:"/**
 * Plans a salesperson's day. The single gate for route-plan data; it does not decide who may (RoutePlanPolicy does) but it
 * enforces the rules of the data:
 *
 *  - a plan is for **one person, one day and one branch**; one plan per person and day, ever (a cancelled plan is
 *    reinstated, not replaced). The planner must manage that person (their team, or everyone with `sales.scope_all`),
 *    and the person must be able to work in that branch;
 *  - a plan is created for today or a later day, and a day that is over is history: it is not edited, cancelled or deleted;
 *  - stops (at most 50) are an area, a block, a PIN code or a customer, in order, each optionally with a place on the
 *    map (both coordinates, a real position), its own radius (50–5000 m) and a visit window; a block, PIN code or customer
 *    must exist in the company's masters, and a customer must be an approved, active customer ledger;
 *  - **publishing** needs at least one stop with a place on the map — otherwise there would be no geofence to check
 *    attendance against — and only a published plan lets the person mark attendance;
 *  - a stop that has been used (it matched an attendance, or a refused attempt was measured against it) is kept.
 *
 * Input: ['plan' => [user_id, location_id, plan_date, title, geofence_radius_m, remarks],
 *         'stops' => [[id?, stop_type, label, block_id, pin_code, ledger_id, latitude, longitude, radius_m, visit_from, visit_to], …]]
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:46;s:7:"endLine";i:538;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:9:"MAX_STOPS";a:12:{s:18:"declaringClassName";s:41:"App\Modules\CRM\Services\RoutePlanService";s:21:"implementingClassName";s:41:"App\Modules\CRM\Services\RoutePlanService";s:4:"name";s:9:"MAX_STOPS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"50";s:10:"attributes";a:6:{s:9:"startLine";i:48;s:7:"endLine";i:48;s:13:"startTokenPos";i:135;s:12:"startFilePos";i:2500;s:11:"endTokenPos";i:135;s:10:"endFilePos";i:2501;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:5;s:9:"endColumn";i:32;}}s:19:"immediateProperties";a:5:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:41:"App\Modules\CRM\Services\RoutePlanService";s:21:"implementingClassName";s:41:"App\Modules\CRM\Services\RoutePlanService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:51;s:7:"endLine";i:51;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"scope";a:16:{s:18:"declaringClassName";s:41:"App\Modules\CRM\Services\RoutePlanService";s:21:"implementingClassName";s:41:"App\Modules\CRM\Services\RoutePlanService";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:52;s:7:"endLine";i