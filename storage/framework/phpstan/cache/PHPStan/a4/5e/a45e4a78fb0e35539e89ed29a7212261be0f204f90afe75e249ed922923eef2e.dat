O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-3e04b3fc4039a44807af5b2a3fd90564d53bd595e83c16e2d14729242790b08f";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:56:"App\Modules\Integrations\Http\Middleware\WebsiteFormCors";s:8:"filename";s:91:"C:/xampp/htdocs/industrial_crm/app/Modules/Integrations/Http/Middleware/WebsiteFormCors.php";}}s:9:"namespace";s:40:"App\Modules\Integrations\Http\Middleware";s:4:"name";s:56:"App\Modules\Integrations\Http\Middleware\WebsiteFormCors";s:9:"shortName";s:15:"WebsiteFormCors";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1114:"/**
 * What a visitor's browser needs from the website form's address, and nothing the other providers get.
 *
 *  - A browser that says which page it is on (`Origin`) is let through only if the company has listed that site (`WebsiteOrigins`); any other site is
 *    refused **403 `origin_not_allowed`**. A request with no `Origin` (a server posting the form, a command line) is not a browser and is judged by the
 *    rest of the checks alone: this list keeps *other websites' pages* from using the form, it does not stop a script, and says so.
 *  - The browser's preflight (`OPTIONS`) is answered here with what it asked about, and every answer — including a refusal or a throttle — carries
 *    `Access-Control-Allow-Origin` for the listed site, so the page's script can read why it failed.
 *  - A plain HTML form (no script) that names a `thanks_url` on a listed site is sent there with `303` after it is accepted, instead of being shown a JSON answer.
 *
 * An address that is not a switched-on website connection is left alone: the controller answers it 404 like any wrong address, with no hint.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:74;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:7:"origins";a:16:{s:18:"declaringClassName";s:56:"App\Modules\Integrations\Http\Middleware\WebsiteFormCors";s:21:"implementingClassName";s:56:"App\Modules\Integrations\Http\Middleware\WebsiteFormCors";s:4:"name";s:7:"origins";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:48:"App\Modules\Integrations\Services\WebsiteOrigins";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:33;s:9:"endColumn";i:72;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:3:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:7:"origins";a:13:{s:4:"name";s:7:"origins";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:48:"App\Modules\Integrations\Services\WebsiteOrigins";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:33;s:9:"endColumn";i:72;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:5;s:9:"endColumn";i:76;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:40:"App\Modules\Integrations\Http\Middleware";s:18:"declaringClassName";s:56:"App\Modules\Integrations\Http\Middleware\WebsiteFormCors";s:21