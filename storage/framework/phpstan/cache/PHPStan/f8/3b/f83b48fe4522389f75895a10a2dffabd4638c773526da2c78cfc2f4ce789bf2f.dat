O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-b3fbd9985fcd40783eaf30d6bd0b48069821dcb682146b294debe5c067f32453";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:8:"filename";s:80:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Console/SendFollowupReminders.php";}}s:9:"namespace";s:23:"App\Modules\CRM\Console";s:4:"name";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:9:"shortName";s:21:"SendFollowupReminders";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1013:"/**
 * Reminds people of their planned follow-ups, and tells their manager about the ones left overdue — in-app and by
 * e-mail, once each.
 *
 * Run by the scheduler every five minutes for every company.
 *
 *  - **Reminder**: a follow-up is due for its reminder when it is planned to happen within the company's lead time
 *    (`followups.remind_minutes_before`, 30 minutes by default) — or is already late — and has not been reminded yet.
 *    Follow-ups more than a day late are left alone: after an outage, a flood of stale reminders helps nobody.
 *  - **Escalation**: a follow-up still planned `followups.escalate_after_hours` (24 by default; 0 = off) after it was
 *    due is reported to the manager of the team its person is on, once. Ones more than 30 days late are left alone.
 *
 * Each is *claimed* with a single conditional UPDATE before anything is sent, so two overlapping runs (or a retried one)
 * can never tell anybody twice; a follow-up that is rescheduled is re-armed for both.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:37;s:7:"endLine";i:203;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:26:"Illuminate\Console\Command";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:16:"MAX_LEAD_MINUTES";a:12:{s:18:"declaringClassName";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:21:"implementingClassName";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:4:"name";s:16:"MAX_LEAD_MINUTES";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4:"1440";s:10:"attributes";a:6:{s:9:"startLine";i:44;s:7:"endLine";i:44;s:13:"startTokenPos";i:127;s:12:"startFilePos";i:2121;s:11:"endTokenPos";i:127;s:10:"endFilePos";i:2124;}}s:10:"docComment";s:102:"/** Longest lead time a company can set, in minutes; also how far ahead the candidates are fetched. */";s:10:"attributes";a:0:{}s:9:"startLine";i:44;s:7:"endLine";i:44;s:11:"startColumn";i:5;s:9:"endColumn";i:42;}s:5:"BATCH";a:12:{s:18:"declaringClassName";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:21:"implementingClassName";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:4:"name";s:5:"BATCH";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4:"2000";s:10:"attributes";a:6:{s:9:"startLine";i:46;s:7:"endLine";i:46;s:13:"startTokenPos";i:138;s:12:"startFilePos";i:2154;s:11:"endTokenPos";i:138;s:10:"endFilePos";i:2157;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:46;s:7:"endLine";i:46;s:11:"startColumn";i:5;s:9:"endColumn";i:31;}}s:19:"immediateProperties";a:2:{s:9:"signature";a:16:{s:18:"declaringClassName";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:21:"implementingClassName";s:45:"App\Modules\CRM\Console\SendFollowupReminders";s:4:"name";s:9:"signature";s:9:"modifiers";i:2;s:4:"type";N;s:7:"default";a:2:{s:4:"code";s:24:"'crm:followup-reminders'";s:10:"attributes";a:6:{s:9:"startLine";i:39;s:7:"endLine";i:39;s:13:"startTokenPos";i:105;s:12:"startFilePos";i:1797;s:11