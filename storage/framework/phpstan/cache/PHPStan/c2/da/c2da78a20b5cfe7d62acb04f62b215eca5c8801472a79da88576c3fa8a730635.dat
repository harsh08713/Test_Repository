O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-862804766683ccf6766daafded784c7344408ebd85e599bb13e1ac3b167f590c";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:44:"App\Modules\Sales\Services\SalesOrderService";s:8:"filename";s:79:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/SalesOrderService.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:44:"App\Modules\Sales\Services\SalesOrderService";s:9:"shortName";s:17:"SalesOrderService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1841:"/**
 * Makes and moves sales orders. The single gate for order data — the screens come through here — so the rules are the same whichever way. It
 * does not decide who may (SalesOrderPolicy does), but it checks on the server what a policy cannot know: the branch against the *actor*,
 * whether the source is still approved and open, the customer, and what state the order is in.
 *
 *  - **Making.** Three sources, one order each: an **approved quotation** (`createFromQuotation`: cleared by QuotationConversionGuard — accepted,
 *    approved, the latest revision, in date — or an audited exception), an **approved deal** (`createFromDeal`, no quotation needed) and a
 *    **direct order** for a regular customer (`createDirect`: a customer with at least `sales_order.direct_min_orders` approved orders). The
 *    customer must be an approved, active customer ledger. A quotation, and a deal, can have one live order at a time (the lock on the source
 *    and the unique keys on `live_quotation_id` / `live_deal_id`); a cancelled order frees them. The number is taken first, in the same
 *    transaction.
 *  - **Prices** are OrderPricer's: copied from the quotation as quoted (company setting) or looked up in the rate master; tax by place of supply.
 *  - **Credit.** The check (CreditCheck) is worked out on every save and again at submission; an order over the limit in a company that blocks
 *    cannot be submitted until someone holding `credit_limit.override` allows it, with a reason (`overrideCredit`, audited).
 *  - **Approval** is the shared workflow; approving it makes the invoice (InvoiceGenerator) and, for an order from a deal, wins the deal.
 *  - **Cancelling** (`cancel`) withdraws the order and, with it, its invoice; it frees the quotation and deal to be ordered again.
 *
 * Input: see OrderPricer.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:54;s:7:"endLine";i:550;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:17:"DEADLOCK_ATTEMPTS";a:12:{s:18:"declaringClassName";s:44:"App\Modules\Sales\Services\SalesOrderService";s:21:"implementingClassName";s:44:"App\Modules\Sales\Services\SalesOrderService";s:4:"name";s:17:"DEADLOCK_ATTEMPTS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"3";s:10:"attributes";a:6:{s:9:"startLine";i:56;s:7:"endLine";i:56;s:13:"startTokenPos";i:170;s:12:"startFilePos";i:3207;s:11:"endTokenPos";i:170;s:10:"endFilePos";i:3207;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:56;s:7:"endLine";i:56;s:11:"startColumn";i:5;s:9:"endColumn";i:40;}}s:19:"immediateProperties";a:12:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:44:"App\Modules\Sales\Services\SalesOrderService";s:21:"implementingClassName";s:44:"App\Modules\Sales\Services\SalesOrderService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:59;s:7:"endLine";i:59;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:7:"numbers";a:16:{s:18:"declaringClassName";s:44:"App\Modules\Sales\Services\SalesOrderService";s:21:"implementingClassName";s:44:"App\Modules\Sales\Services\SalesOrderService";s:4:"name";s:7:"numbers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"at