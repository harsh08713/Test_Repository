 * The one door for employee data: the file itself, changes of job (each written to the append-only history), notice and exit, contacts and papers.
 *
 * Rules kept here, not in the screens:
 *   - an employee code is unique in the company; a person is at least 14 and joins no more than 90 days ahead;
 *   - a manager is an active employee of the same company, never the person themself and never someone who (directly or further up) reports to them — no cycles;
 *   - a person's login is linked to one employee file only, and only if the login belongs to the company;
 *   - notice, exit and re-joining need `employee.record_exit`; the last working day switches the person's login off (`finaliseExit`, also run by `hr:sync-exits`);
 *   - a person who has left cannot be changed, only re-joined; the history is never edited.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:659;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:12:"MAX_CONTACTS";a:12:{s:18:"declaringClassName";s:39:"App\Modules\HR\Services\EmployeeService";s:21:"implementingClassName";s:39:"App\Modules\HR\Services\EmployeeService";s:4:"name";s:12:"MAX_CONTACTS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"5";s:10:"attributes";a:6:{s:9:"startLine";i:36;s:7:"endLine";i:36;s:13:"startTokenPos";i:115;s:12:"startFilePos";i:1656;s:11:"endTokenPos";i:115;s:10:"endFilePos";i:1656;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:36;s:11:"startColumn";i:5;s:9:"endColumn";i:34;}s:15:"MAX_DOCUMENT_KB";a:12:{s:18:"declaringClassName";s:39:"App\Modules\HR\Services\EmployeeService";s:21:"implementingClassName";s:39:"App\Modules\HR\Services\EmployeeService";s:4:"name";s:15:"MAX_DOCUMENT_KB";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4:"5120";s:10:"attributes";a:6:{s:9:"startLine";i:38;s:7:"endLine";i:38;s:13:"startTokenPos";i:126;s:12:"startFilePos";i:1695;s:11:"endTokenPos";i:126;s:10:"endFilePos";i:1698;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:5;s:9:"endColumn";i:40;}}s:19:"immediateProperties";a:1:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:39:"App\Modules\HR\Services\EmployeeService";s:21:"implementingClassName";s:39:"App\Modules\HR\Services\EmployeeService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:40;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"d