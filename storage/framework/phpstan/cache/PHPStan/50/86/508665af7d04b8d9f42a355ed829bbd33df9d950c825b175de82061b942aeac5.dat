O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-0d118c4840679553b14b5c746c0da349306acac925c0af34e0a03e7c1f30c5d3";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:42:"App\Modules\Sales\Services\QuotationPricer";s:8:"filename";s:77:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/QuotationPricer.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:42:"App\Modules\Sales\Services\QuotationPricer";s:9:"shortName";s:15:"QuotationPricer";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1657:"/**
 * Turns what a person typed into a priced, taxed quotation — and saves nothing. The service that saves (QuotationService) and the
 * screen that previews the total both come here, so the figure shown is the figure that will be stored.
 *
 *  - **Who and where**: the customer's name, contact and billing address are copies (they start from the deal or the customer
 *    ledger and may be adjusted on the quotation); the **place of supply** is a state, and with the supplier's state (the branch's,
 *    else the company's) it decides CGST + SGST or IGST (TaxService).
 *  - **Prices come only from the rate master** (RateService::getRate), as of the quotation's price date and in its price list
 *    (falling back to the standard rate, and the line says which it used). A line that is unchanged keeps the price it was saved
 *    with; a new or changed line, a new price list, or "refresh rates", looks the rate up again.
 *  - **A changed rate** needs `rate.override`, a reason, and leaves an audit entry on the rate (recorded by QuotationService once
 *    the quotation exists, from the `audit` of the line returned here).
 *  - **Tax** per line: the item's HSN and GST rate (or the ones the line was saved with), the discount per cent, all through TaxService.
 *
 * Input: ['quotation' => [valid_until, price_list_id, place_of_supply_state_id, party_name, contact_person, mobile, email, bill_line1,
 *         bill_line2, bill_city, bill_pin_code, customer_gstin, terms, remarks, reprice?],
 *         'items' => [[id?, deal_item_id?, lead_interest_id?, item_id, unit_id, quantity, discount_percent, rate_override?, override_reason?], …]]
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:47;s:7:"endLine";i:604;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:10:"MAX_AMOUNT";a:12:{s:18:"declaringClassName";s:42:"App\Modules\Sales\Services\QuotationPricer";s:21:"implementingClassName";s:42:"App\Modules\Sales\Services\QuotationPricer";s:4:"name";s:10:"MAX_AMOUNT";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:18:"'9999999999999.99'";s:10:"attributes";a:6:{s:9:"startLine";i:50;s:7:"endLine";i:50;s:13:"startTokenPos";i:142;s:12:"startFilePos";i:2776;s:11:"endTokenPos";i:142;s:10:"endFilePos";i:2793;}}s:10:"docComment";s:69:"/** The largest amount a stored money column holds (decimal 15,2). */";s:10:"attributes";a:0:{}s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:5;s:9:"endColumn";i:50;}}s:19:"immediateProperties";a:5:{s:5:"items";a:16:{s:18:"declaringClassName";s:42:"App\Modules\Sales\Services\QuotationPricer";s:21:"implementingClassName";s:42:"App\Modules\Sales\Services\QuotationPricer";s:4:"name";s:5:"items";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:39:"App\Modules\Masters\Services\ItemLookup";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:53;s:7:"endLine";i:53;s:11:"startColumn";i:9;s:9:"endColumn";i:42;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:4:"uoms";a:16:{s:18:"declaringClassName";s:42:"App\Modules\Sales\Services\QuotationPricer";s:21:"implementingClassName";s:42:"App\Modules\Sales\Services\QuotationPricer";s:4:"name";s:4:"uoms";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\Masters\Services\UomConverter";s:12:"isIdentifier"