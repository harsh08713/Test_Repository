O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-a8cd31d006f90a6fd36dd634bd374601042bcedc36aa4bdaef624060348e5a92";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:45:"App\Modules\Sales\Services\SalesReturnService";s:8:"filename";s:80:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/SalesReturnService.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:45:"App\Modules\Sales\Services\SalesReturnService";s:9:"shortName";s:18:"SalesReturnService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1113:"/**
 * Makes and changes sales returns and credit notes — the one door for their data.
 *
 * A return is made against one **issued** invoice (not a cancelled one) and takes quantity off its lines at the rate, discount and GST those
 * lines carried (TaxService, the same arithmetic as the invoice, so returning a whole line reproduces it exactly). What may still be returned
 * of a line is its invoiced quantity less what other returns have taken that are **pending or approved**: a draft or a rejected one reserves
 * nothing. That is checked when the return is saved and again, under a lock on the invoice, when it is sent for approval, so two returns that
 * each fit alone cannot both go through when together they do not.
 *
 * The cost of a returned line is the invoice line's own cost snapshot (unit cost × returned quantity) — never today's cost; a line whose invoice
 * line had no cost has none, and then so does the return's total.
 *
 * Input: ['return_type' => 'return'|'credit_note', 'return_date' => 'Y-m-d' (optional, today), 'reason' => string, 'lines' => [invoice line id => quantity]]
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:333;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:4:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:45:"App\Modules\Sales\Services\SalesReturnService";s:21:"implementingClassName";s:45:"App\Modules\Sales\Services\SalesReturnService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:36;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:7:"numbers";a:16:{s:18:"declaringClassName";s:45:"App\Modules\Sales\Services\SalesReturnService";s:21:"implementingClassName";s:45:"App\Modules\Sales\Services\SalesReturnService";s:4:"name";s:7:"numbers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:37;s:7:"endLine";i:37;s:11:"startColumn";i:9;s:9:"endColumn";i:53;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:3:"tax";a:16:{s:18:"declaringClassName";s:45:"App\Modules\Sales\Services\SalesReturnService";s:21:"implementingClassName";s:45:"App\Modules\Sales\Services\SalesReturnService";s:4:"name";s:3:"tax";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:37:"App\Modules\Sales\Services\TaxServ