 * Issues gap-free document numbers such as QT/AHD/26-27/00001
 * (prefix / branch code / financial year / sequence), one counter per
 * company + branch + document type + financial year.
 *
 * The counter row is locked (SELECT ... FOR UPDATE) inside a transaction, so concurrent
 * requests can never receive the same number. Call next() inside the same transaction that
 * saves the document: if that transaction rolls back, the number is not consumed.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:140;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:17:"DEADLOCK_ATTEMPTS";a:12:{s:18:"declaringClassName";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:21:"implementingClassName";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:4:"name";s:17:"DEADLOCK_ATTEMPTS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"5";s:10:"attributes";a:6:{s:9:"startLine";i:34;s:7:"endLine";i:34;s:13:"startTokenPos";i:82;s:12:"startFilePos";i:1512;s:11:"endTokenPos";i:82;s:10:"endFilePos";i:1512;}}s:10:"docComment";s:450:"/**
 * The counter is created and locked without a gap lock (see lockSeries), so issuing the first number of a series
