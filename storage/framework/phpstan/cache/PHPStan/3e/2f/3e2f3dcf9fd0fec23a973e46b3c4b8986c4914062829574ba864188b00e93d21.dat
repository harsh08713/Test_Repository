 * Every figure the executive dashboard and the analytics pages show, worked out **in one place** so a card, a chart, a table and a JSON answer can never
 * disagree. It owns no new rule: revenue, cost, margin and loss come from `Profitability` and `LossFigures` (which hold the formulas of FORMULAS.md), and
 * this class only slices them by date, industry and branch, compares them with the previous period and shapes them for a screen. Everything runs through
 * the tenant and branch scopes, so a person's dashboard shows only what they are allowed to see.
 *
 * Money is returned as decimal strings, percentages as decimal strings with two places, and a figure that has nothing to divide by is **null** (shown "—"),
 * never zero. Each KPI card carries its own `formula` so the screen can say exactly what the number means.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:415;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:3:{s:6:"profit";a:16:{s:18:"declaringClassName";s:49:"App\Modules\Analytics\Services\DashboardAnalytics";s:21:"implementingClassName";s:49:"App\Modules\Analytics\Services\DashboardAnalytics";s:4:"name";s:6:"profit";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:42:"App\Modules\Finance\Services\Profitability";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:30;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:6:"losses";a:16:{s:18:"declaringClassName";s:49:"App\Modules\Analytics\Services\DashboardAnalytics";s:21:"implementingClassName";s:49:"App\Modules\Analytics\Services\DashboardAnalytics";s:4:"name";s:6:"losses";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:37:"App\Modules\Loss\Services\LossFigures";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:9;s:9:"endColumn";i:44;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:9:"templates";a:16:{s:18:"declaringClassName";s:49:"App\Modules\Analytics\Services\DashboardAnalytics";s:21:"implementingClassName";s:49:"App\Modules\Analytics\Services\DashboardAnalytics";s:4:"name";s:9:"templates";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:53:"App\Modu