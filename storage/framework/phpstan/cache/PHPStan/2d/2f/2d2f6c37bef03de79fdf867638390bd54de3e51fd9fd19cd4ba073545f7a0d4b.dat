O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-97e2ec5b76cf03bb73fbf315a7dfbc67ee0637d6f705d167529a285a8ea3ceae";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:8:"filename";s:80:"C:/xampp/htdocs/industrial_crm/app/Modules/Marketing/Services/WorkflowEngine.php";}}s:9:"namespace";s:30:"App\Modules\Marketing\Services";s:4:"name";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:9:"shortName";s:14:"WorkflowEngine";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1182:"/**
 * Runs the workflows that are on, on a schedule (`automation:run`). For each, it finds the occurrences of its trigger since it was switched on, and for
 * each one, once:
 *
 *  1. **claims** it by writing the run (`unique(workflow_id, trigger_key)` — the same event never runs the same workflow twice, however many sweeps overlap);
 *  2. checks the **limits** (a workflow's runs per hour, and per record per day), then the **conditions** (a run whose conditions fail is recorded as skipped);
 *  3. does the **actions**, as the person the workflow runs as, with the same checks as if that person did them by hand: they must still be active and hold
 *     the rights, must be able to see the record, and every action goes through the service the screens use (tasks, lead transfers, consent-checked messages).
 *     A workflow can never approve a document, skip consent, or reach another company.
 *
 * In dry-run the actions are only described. A failed run can be retried: the actions that worked are not done again.
 * Nothing a workflow does is itself a trigger (no action creates a lead, changes a stage, approves anything), so workflows cannot set each other off.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:375;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:4:{s:13:"STUCK_MINUTES";a:12:{s:18:"declaringClassName";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:21:"implementingClassName";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:4:"name";s:13:"STUCK_MINUTES";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"10";s:10:"attributes";a:6:{s:9:"startLine";i:41;s:7:"endLine";i:41;s:13:"startTokenPos";i:122;s:12:"startFilePos";i:2178;s:11:"endTokenPos";i:122;s:10:"endFilePos";i:2179;}}s:10:"docComment";s:62:"/** A run that has been "running" this long never finished. */";s:10:"attributes";a:0:{}s:9:"startLine";i:41;s:7:"endLine";i:41;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}s:18:"PER_RECORD_PER_DAY";a:12:{s:18:"declaringClassName";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:21:"implementingClassName";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:4:"name";s:18:"PER_RECORD_PER_DAY";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"3";s:10:"attributes";a:6:{s:9:"startLine";i:43;s:7:"endLine";i:43;s:13:"startTokenPos";i:133;s:12:"startFilePos";i:2222;s:11:"endTokenPos";i:133;s:10:"endFilePos";i:2222;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:43;s:11:"startColumn";i:5;s:9:"endColumn";i:41;}s:9:"PER_SWEEP";a:12:{s:18:"declaringClassName";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:21:"implementingClassName";s:45:"App\Modules\Marketing\Services\WorkflowEngine";s:4:"name";s:9:"PER_SWEEP";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"100";s:10:"attributes";a:6:{s:9:"startLine";i:45;s:7:"endLine";i:45;s:13:"startTokenPos";i:144;s:12:"startFilePos";i:2256;s:11:"endTokenPos";i:144;s:10:"endFilePos";i:2258;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:45;