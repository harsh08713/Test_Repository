O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-8da9e5233d6b5ed5fc222ed21891828b136813ba9aa82a99892e5617ab8f6e58";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:48:"App\Modules\Sales\Services\SalesOrderAchievement";s:8:"filename";s:83:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/SalesOrderAchievement.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:48:"App\Modules\Sales\Services\SalesOrderAchievement";s:9:"shortName";s:21:"SalesOrderAchievement";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:871:"/**
 * What a salesperson has achieved, from sales orders — the policy the AchievementSource contract describes, now live:
 *
 *  - only **approved** orders count; a **cancelled** order does not (and an approved order cancelled later stops counting at once);
 *  - an order counts on its **order date**, for the salesperson credited with it (`assigned_to`);
 *  - the value is the lines' amount **net of tax** (after discount, before GST);
 *  - an order counts **in full when approved**, invoiced or not — a partly invoiced order does not count less;
 *  - a quantity counts in each item's **base unit** (the unit's conversion factor is applied);
 *  - the target's item group filters the order *lines* and its branch filters the order's branch;
 *  - **returns and credit notes** do not exist yet; when they do they reduce the period in which they are recorded.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:63;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:1:{i:0;s:43:"App\Modules\CRM\Contracts\AchievementSource";}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:3:{s:8:"achieved";a:20:{s:4:"name";s:8:"achieved";s:10:"parameters";a:5:{s:6:"userId";a:13:{s:4:"name";s:6:"userId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:24;s:11:"startColumn";i:30;s:9:"endColumn";i:40;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"from";a:13:{s:4:"name";s:4:"from";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:24;s:11:"startColumn";i:43;s:9:"endColumn";i:54;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:2:"to";a:13:{s:4:"name";s:2:"to";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:24;s:11:"startColumn";i:57;s:9:"endColumn";i:66;s:14:"parameterIndex";i:2;s:10:"isOptional";b:0;}s:11:"itemGroupId";a:13:{s:4:"name";s:11:"itemGroupId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2: