O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-2a5e889463f33a57bcc70af2fad5dcc90ec54e4edb22d9493b119a6e545e9b7a";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:38:"App\Modules\Sales\Services\OrderPricer";s:8:"filename";s:73:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/OrderPricer.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:38:"App\Modules\Sales\Services\OrderPricer";s:9:"shortName";s:11:"OrderPricer";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1761:"/**
 * Turns what a person typed into a priced, taxed sales order — and saves nothing (SalesOrderService saves; the order form's live preview asks
 * for the same answer, so the figure shown is the figure that will be stored). It does for orders what QuotationPricer does for quotations,
 * with the order's own policy on prices:
 *
 *  - **From a quotation** the default policy is **copy**: a line that still has the item and unit it was quoted with keeps the quotation's
 *    price, discount-free rate, GST rate and rate-override note exactly (the customer was promised that price, and an override already
 *    audited is not audited twice); only the quantity and the discount can be adjusted. Company setting `sales_order.quotation_pricing =
 *    rates` looks every line up again instead. A line the quotation did not have, or whose item or unit changed, is looked up.
 *  - **From a deal or direct** every line is looked up in the rate master (RateService, as of the order's price date, in its price list).
 *  - **On an order being edited**, an unchanged line keeps the price it was saved with unless "refresh rates" is asked for.
 *  - A changed rate needs `rate.override`, a reason, and leaves an audit entry on the rate (recorded by SalesOrderService once the order exists).
 *  - Tax per line and totals are TaxService's, by the place of supply.
 *
 * Input: ['order' => [delivery_date, customer_po_number, customer_po_date, price_list_id, place_of_supply_state_id, party_name, contact_person,
 *         mobile, email, bill_line1…, customer_gstin, ship_line1…, terms, remarks, reprice?],
 *         'items' => [[id?, quotation_item_id?, deal_item_id?, item_id, unit_id, quantity, discount_percent, rate_override?, override_reason?], …]]
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:50;s:7:"endLine";i:649;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:10:"MAX_AMOUNT";a:12:{s:18:"declaringClassName";s:38:"App\Modules\Sales\Services\OrderPricer";s:21:"implementingClassName";s:38:"App\Modules\Sales\Services\OrderPricer";s:4:"name";s:10:"MAX_AMOUNT";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:18:"'9999999999999.99'";s:10:"attributes";a:6:{s:9:"startLine";i:52;s:7:"endLine";i:52;s:13:"startTokenPos";i:155;s:12:"startFilePos";i:2929;s:11:"endTokenPos";i:155;s:10:"endFilePos";i:2946;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:52;s:7:"endLine";i:52;s:11:"startColumn";i:5;s:9:"endColumn";i:50;}}s:19:"immediateProperties";a:5:{s:5:"items";a:16:{s:18:"declaringClassName";s:38:"App\Modules\Sales\Services\OrderPricer";s:21:"implementingClassName";s:38:"App\Modules\Sales\Services\OrderPricer";s:4:"name";s:5:"items";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:39:"App\Modules\Masters\Services\ItemLookup";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:55;s:7:"endLine";i:55;s:11:"startColumn";i:9;s:9:"endColumn";i:42;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:4:"uoms";a:16:{s:18:"declaringClassName";s:38:"App\Modules\Sales\Services\OrderPricer";s:21:"implementingClassName";s:38:"App\Modules\Sales\Services\OrderPricer";s:4:"name";s:4:"uoms";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\Masters\Services\UomConverter";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:56;s:7:"endLin