O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-4d7c72159cb2f8e79dea902a1e859728610919ae10ed9cfbedad83931ecd8024";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:44:"App\Modules\CRM\Services\LeadTransferService";s:8:"filename";s:79:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/LeadTransferService.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:44:"App\Modules\CRM\Services\LeadTransferService";s:9:"shortName";s:19:"LeadTransferService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:969:"/**
 * Hands leads from one person to another — one lead or many at once — and keeps the whole history.
 *
 * Every transfer is checked on the server, lead by lead, whatever ids the browser sent:
 *
 *  - each lead must be one the person transferring may work (LeadAccess: theirs, their team's or the pool they keep) —
 *    a follow-up on somebody else's lead is not enough — and must still be open;
 *  - the new owner must be an active user of the company, must be the person transferring or someone they manage
 *    (anyone, for a holder of `sales.scope_all`), and must work in each lead's branch;
 *  - a reason is required.
 *
 * **All or nothing**: if any selected lead fails a check, none is moved and the message says which and why — a bulk
 * transfer never half-happens. Each moved lead gets a `lead_transfers` row (from, to, teams, reason, by whom, when), its
 * planned follow-ups go to the new owner with it, and the new owner is told once.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:138;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:16:"MAX_PER_TRANSFER";a:12:{s:18:"declaringClassName";s:44:"App\Modules\CRM\Services\LeadTransferService";s:21:"implementingClassName";s:44:"App\Modules\CRM\Services\LeadTransferService";s:4:"name";s:16:"MAX_PER_TRANSFER";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"200";s:10:"attributes";a:6:{s:9:"startLine";i:32;s:7:"endLine";i:32;s:13:"startTokenPos";i:70;s:12:"startFilePos";i:1442;s:11:"endTokenPos";i:70;s:10:"endFilePos";i:1444;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:5;s:9:"endColumn";i:40;}}s:19:"immediateProperties";a:5:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:44:"App\Modules\CRM\Services\LeadTransferService";s:21:"implementingClassName";s:44:"App\Modules\CRM\Services\LeadTransferService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"scope";a:16:{s:18:"declaringClassName";s:44:"App\Modules\CRM\Services\LeadTransferService";s:21:"implementingClassName";s:44:"App\Modules\CRM\Services\LeadTransferService";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9