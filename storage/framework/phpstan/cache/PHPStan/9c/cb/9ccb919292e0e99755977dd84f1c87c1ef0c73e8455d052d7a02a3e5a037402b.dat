 * @property string|null $invoice_error
 */";s:10:"attributes";a:2:{i:0;a:3:{s:4:"name";s:48:"Illuminate\Database\Eloquent\Attributes\Fillable";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:79:"['delivery_date', 'customer_po_number', 'customer_po_date', 'terms', 'remarks']";s:10:"attributes";a:6:{s:9:"startLine";i:98;s:7:"endLine";i:98;s:13:"startTokenPos";i:147;s:12:"startFilePos";i:4150;s:11:"endTokenPos";i:161;s:10:"endFilePos";i:4228;}}}}i:1;a:3:{s:4:"name";s:49:"Illuminate\Database\Eloquent\Attributes\UsePolicy";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:51:"\App\Modules\Sales\Policies\SalesOrderPolicy::class";s:10:"attributes";a:6:{s:9:"startLine";i:99;s:7:"endLine";i:99;s:13:"startTokenPos";i:168;s:12:"startFilePos";i:4244;s:11:"endTokenPos";i:170;s:10:"endFilePos";i:4266;}}}}}s:9:"startLine";i:98;s:7:"endLine";i:364;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:37:"App\Modules\Shared\Models\TenantModel";s:20:"implementsClassNames";a:1:{i:0;s:47:"App\Modules\Shared\Contracts\ApprovableDocument";}s:15:"traitClassNames";a:3:{i:0;s:45:"App\Modules\Shared\Models\Concerns\Approvable";i:1;s:52:"App\Modules\Shared\Models\Concerns\BelongsToLocation";i:2;s:57:"App\Modules\Shared\Models\Concerns\ValidatesParentCompany";}s:18:"immediateConstants";a:1:{s:14:"MOVING_COLUMNS";a:12:{s:18:"declaringClassName";s:35:"App\Modules\Sales\Models\SalesOrder";s:21:"implementingClassName";s:35:"App\Modules\Sales\Models\SalesOrder";s:4:"name";s:14:"MOVING_COLUMNS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:326:"['approval_status', 'approved_by', 'approved_at', 'state', 'cancelled_at', 'cancel_reason', 'cancelled_by', 'invoiced_at', 'invoice_attempted_at', 'invoice_error', 'credit_override_reason', 'credit_override_by', 'credit_result', 'credit_checked_at', 'credit_limit', 'credit_exposure', 'updated_by', 'updated_at', 'deleted_at']";s:10:"attributes";a:6:{s:9:"startLine";i:105;s:7:"endLine";i:109;s:13:"startTokenPos";i:209;s:12:"startFilePos"