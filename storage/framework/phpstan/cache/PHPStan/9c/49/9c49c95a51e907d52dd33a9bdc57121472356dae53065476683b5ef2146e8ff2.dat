ion\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:390:"/**
 * The deal made from this lead, if it has been converted — whoever is asking, in any branch. $lock asks for the latest committed
