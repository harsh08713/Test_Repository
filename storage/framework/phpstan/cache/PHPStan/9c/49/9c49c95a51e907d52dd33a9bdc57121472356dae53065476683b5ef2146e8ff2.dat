O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-5c938784d8ec1a83d23969dbe25ec137031d51292424360f73068609a9dcd0fa";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:36:"App\Modules\CRM\Services\DealService";s:8:"filename";s:71:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/DealService.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:36:"App\Modules\CRM\Services\DealService";s:9:"shortName";s:11:"DealService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:2603:"/**
 * Creates and changes deals. The single gate for deal data — the screens and the mobile API both come through here — so the
 * rules are the same whichever way a deal is made or changed. It does not decide who may (DealPolicy and LeadPolicy do), but
 * it does check on the server what a policy cannot know: the branch against the *actor*, whether the lead is still
 * convertible and whether the lines are real.
 *
 *  - **Conversion** (`convert`): a *qualified* lead that has an owner becomes a deal — once. The lead is locked while it is
 *    converted, `deals.lead_id` is unique, and the number is taken first, so two people converting the same lead at the same
 *    moment make one deal and one of them is told. Every line the lead listed comes across (a line of the lead may be
 *    adjusted but not dropped, and an item may not be swapped for another): to leave something out, edit the lead first.
 *    The deal keeps the lead's branch, owner and team, a snapshot of who the lead was, and the link back to the lead and to
 *    each of its lines. The lead moves to the Deal stage.
 *  - **Lines**: each is an approved, active item, a unit it is sold in, a quantity the unit allows (a unit that cannot be
 *    split takes whole numbers only) and the rate expected. The amount of a line is quantity × rate, rounded half up to paise,
 *    and the deal's value is the sum of the lines — both worked out here, never accepted from the client.
 *  - **Customer**: a deal from an existing customer's inquiry is for that customer; a deal from a new lead may be linked to a
 *    customer ledger (approved and active) once there is one.
 *  - **Content and progress**: the customer and the lines are what an approver signs off on, so they change only while the
 *    deal is a draft or was returned (`update`). Its close date, probability and remarks move on while it is open, approved or
 *    not (`updateProgress`).
 *  - **Stages** (`changeStage`): by DealStage's rules, each move written to the history; Lost needs a reason and re-opening a
 *    comment; Quotation and Won are set only by the documents that follow (`setStageBySystem`), and only for an approved
 *    deal. The lead follows the deal: Deal, Quotation, Won — and Lost with it.
 *  - **Hand-over** (`reassign`): the deal and its lead change hands together, through LeadTransferService, so the history of
 *    both is kept.
 *
 * Input: ['deal' => [customer_ledger_id, expected_close_date, probability, remarks],
 *         'items' => [[id?, lead_interest_id?, item_id, unit_id, quantity, expected_rate], …]]
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:59;s:7:"endLine";i:754;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:3:{s:9:"MAX_LINES";a:12:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\DealService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\DealService";s:4:"name";s:9:"MAX_LINES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:52:"\App\Modules\CRM\Services\LeadService::MAX_INTERESTS";s:10:"attributes";a:6:{s:9:"startLine";i:61;s:7:"endLine";i:61;s:13:"startTokenPos";i:145;s:12:"startFilePos";i:3703;s:11:"endTokenPos";i:147;s:10:"endFilePos";i:3728;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:61;s:7:"endLine";i:61;s:11:"startColumn";i:5;s:9:"endColumn";i:56;}s:10:"MAX_AMOUNT";a:12:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\DealService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\DealService";s:4:"name";s:10:"MAX_AMOUNT";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:18:"'9999999999999.99'";s:10:"attributes";a:6:{s:9:"startLine";i:64;s:7:"endLine";i:64;s:13:"startTokenPos";i:160;s:12:"startFilePos";i:3837;s:11:"endTokenPos";i:160;s:10:"endFilePos";i:3854;}}s:10:"docComment";s:69:"/** The largest amount a stored money column holds (decimal 15,2). */";s:10:"attributes";a:0:{}s:9:"startLine";i:64;s:7:"endLine";i:64;s:11:"startColumn";i:5;s:9:"endColumn";i:50;}s:17:"DEADLOCK_ATTEMPTS";a:12:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\DealService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\DealService";s:4:"name";s:17:"DEADLOCK_ATTEMPTS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"3";s:10:"attributes";a:6:{s:9:"startLine";i:66;s:7:"endLine";i:66;s:13:"startTokenPos";i:171;s:12:"startFilePos";i:3896;s:11:"endTokenPos";i:171;s:10:"endFilePos";i:3896;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"star