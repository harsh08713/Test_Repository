 * The one door for corrective and preventive actions (CAPA).
 *
 *  open ──start──▶ in_progress ──complete──▶ done ──verify──▶ verified
 *    │                 ▲                        │
 *    └──reject──▶ rejected ◀──reject── (open / in progress / done)      done ──send back──▶ in_progress
 *
 *  - Made on an incident that is still open, by someone holding `corrective_action.create`; numbered first. The owner must be able to work actions in
 *    this company; a named approver must hold `corrective_action.approve`.
 *  - Its **owner** (or someone who may edit actions) starts it and says it is done, with notes.
 *  - Someone holding `corrective_action.approve` who is **not its owner** (and is its named approver, if there is one) verifies it and records the
 *    **verified result** — the realised saving, counted only from then on — or sends it back, or rejects it, with a reason.
 *  - Every move is in `workflow_events` and the audit log.
 *  - **Overdue** is not a state: `escalateOverdue()` (the scheduler) tells the owner and approver once when an open or in-progress action passes its due date.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:248;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:3:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:37:"App\Modules\Loss\Services\CapaService";s:21:"implementingClassName";s:37:"App\Modules\Loss\Services\CapaService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:36;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:7:"numbers";a:16:{s:18:"declaringClassName";s:37:"App\Modules\Loss\Services\CapaService";s:21:"implementingClassName";s:37:"App\Modules\Loss\Services\CapaService";s:4:"name";s:7:"numbers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:36;s:11:"startColumn";i:73;s:9:"endColumn";i:117;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"workflow";a:16:{s:18:"declaringClassName";s:37:"App\Modules\Loss\Services\CapaService";s:21:"implementingClassName";s:37:"App\Modules\Loss\Services\CapaService";s:4:"name";s:8:"workflow";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:45:"App\Modules\Loss\Services\LossWorkflowService";s:12:"isIdentifier";b: