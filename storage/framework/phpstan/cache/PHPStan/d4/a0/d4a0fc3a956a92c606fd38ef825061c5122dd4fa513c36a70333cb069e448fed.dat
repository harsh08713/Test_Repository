O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-506a2e43ef6c3486e692dbed94d2916be0f7a4ff67dbff29beabf3430f5f1118";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:37:"App\Modules\Sales\Services\TaxService";s:8:"filename";s:72:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/TaxService.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:37:"App\Modules\Sales\Services\TaxService";s:9:"shortName";s:10:"TaxService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1244:"/**
 * GST on a sales document, in one place: whether a supply is within the state or between states, the tax of a line and the
 * totals of a document. Pure arithmetic on decimal strings (bcmath) — no database, no floats — so the quotation today and the
 * order and the invoice after it all work a figure out the same way.
 *
 *  - **Place of supply.** The tax goes to the state the goods are supplied *to*. If that is the supplier's own state (the GST
 *    state codes are equal) the supply is **intra-state** and the tax is split into half CGST and half SGST; otherwise it is
 *    **inter-state** and the whole of it is IGST.
 *  - **A line.** gross = quantity × rate, discount = gross × discount %, taxable = gross − discount, tax = taxable × GST rate.
 *    Every money figure is rounded **half up to paise** where it is worked out. For an intra-state line CGST and SGST are
 *    each worked out from half the rate and rounded on their own (so they are always equal to each other).
 *  - **A document.** The lines' figures are added up as they are; the grand total is then rounded to the **nearest rupee**
 *    (half up) and the difference is shown as the round-off, so the total is a whole-rupee amount that can be paid.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:21;s:7:"endLine";i:150;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:3:{s:5:"INTRA";a:12:{s:18:"declaringClassName";s:37:"App\Modules\Sales\Services\TaxService";s:21:"implementingClassName";s:37:"App\Modules\Sales\Services\TaxService";s:4:"name";s:5:"INTRA";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:7:"'intra'";s:10:"attributes";a:6:{s:9:"startLine";i:23;s:7:"endLine";i:23;s:13:"startTokenPos";i:30;s:12:"startFilePos";i:1372;s:11:"endTokenPos";i:30;s:10:"endFilePos";i:1378;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:5;s:9:"endColumn";i:33;}s:5:"INTER";a:12:{s:18:"declaringClassName";s:37:"App\Modules\Sales\Services\TaxService";s:21:"implementingClassName";s:37:"App\Modules\Sales\Services\TaxService";s:4:"name";s:5:"INTER";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:7:"'inter'";s:10:"attributes";a:6:{s:9:"startLine";i:25;s:7:"endLine";i:25;s:13:"startTokenPos";i:41;s:12:"startFilePos";i:1407;s:11:"endTokenPos";i:41;s:10:"endFilePos";i:1413;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:25;s:11:"startColumn";i:5;s:9:"endColumn";i:33;}s:11:"MAX_PERCENT";a:12:{s:18:"declaringClassName";s:37:"App\Modules\Sales\Services\TaxService";s:21:"implementingClassName";s:37:"App\Modules\Sales\Services\TaxService";s:4:"name";s:11:"MAX_PERCENT";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:5:"'100'";s:10:"attributes";a:6:{s:9:"startLine";i:28;s:7:"endLine";i:28;s:13:"startTokenPos";i:54;s:12:"startFilePos";i:1512;s:11:"endTokenPos";i:54;s:10:"endFilePos";i:1516;}}s:10:"docComment";s:59:"/** Per cent bounds: a line's discount and its GST rate. */";s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}}s:19:"immediateProp