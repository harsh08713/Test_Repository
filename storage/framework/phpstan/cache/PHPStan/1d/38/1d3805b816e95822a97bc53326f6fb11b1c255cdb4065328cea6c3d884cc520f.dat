O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-67ea05f7836b0202bd78da79339f7eee3e4f19cab2b457f37eb246b9f0d80d70";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Finance\Services\BudgetVsActual";s:8:"filename";s:78:"C:/xampp/htdocs/industrial_crm/app/Modules/Finance/Services/BudgetVsActual.php";}}s:9:"namespace";s:28:"App\Modules\Finance\Services";s:4:"name";s:43:"App\Modules\Finance\Services\BudgetVsActual";s:9:"shortName";s:14:"BudgetVsActual";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:987:"/**
 * Budget against actual loss, per cost centre and loss category, for a run of months — FORMULAS.md "budget variance". The only place it is worked out.
 *
 *   budget    Σ **approved** budgets of the cost centre (and category) for the months in the period
 *   actual    Σ validated actual figures (current, not superseded) of incidents tagged with the cost centre that occurred in the period, are not
 *             duplicates and not rejected — of that category; for a budget with no category, of every category of the cost centre
 *   variance  actual − budget (positive = over budget)
 *   variance %  variance ÷ budget × 100, 2 decimals half up away from zero; null when the budget is 0
 *
 * A category with actual loss but no budget shows with a budget of 0 (so it is never hidden). The cost centre is flat: a parent does not add up its
 * children. Everything is limited to the company and the branches the person works in (incidents) through the tenant scopes.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:92;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:2:{s:9:"forPeriod";a:20:{s:4:"name";s:9:"forPeriod";s:10:"parameters";a:3:{s:4:"from";a:13:{s:4:"name";s:4:"from";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:22:"Carbon\CarbonInterface";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:31;s:9:"endColumn";i:51;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:2:"to";a:13:{s:4:"name";s:2:"to";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:22:"Carbon\CarbonInterface";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:54;s:9:"endColumn";i:72;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:12:"costCenterId";a:13:{s:4:"name";s:12:"costCenterId";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:27;s:7:"endLine";i:27;s:13:"startTokenPos";i:62;s:12:"startFilePos";i:1524;s:11:"endTokenPos";i:62;s:10:"endFilePos";i:1527;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b