O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-ea2b4db476bfd1e8875e33725c502c0b8957bf1534aadf4f620f9990191d5ab5";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\CRM\Services\RouteSuggestion";s:8:"filename";s:75:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/RouteSuggestion.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:40:"App\Modules\CRM\Services\RouteSuggestion";s:9:"shortName";s:15:"RouteSuggestion";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1335:"/**
 * Suggests an order for a day's stops. **Advice only**: it reads coordinates and returns an order and some numbers; it saves nothing, moves nothing and
 * knows nothing about permissions — the planner looks at it and chooses, and the plan is saved through RoutePlanService as ever.
 *
 *  - Distances are straight lines over the earth (`GeoMath`, the same haversine the geofence uses), not roads: a river, a ring road or a one-way street is
 *    invisible to it. A road-distance provider would be one more class behind this one; none is wired in (a provider's terms, keys and rate limits are the
 *    owner's to accept).
 *  - It starts from the given start point (the branch, when it has coordinates) or, failing that, from the first stop as the planner has it — and then
 *    visits the nearest stop that is left, and finally tries swapping stretches of the route (2-opt) while that shortens it. Ties go to the earlier stop, so
 *    the same stops always give the same order.
 *  - A stop with no coordinates cannot be placed: it keeps its place in the planner's order and is reported as unplaced (see `unplaced`).
 *  - Visit windows are **not** forced: `windowClashes()` lists the stops whose window starts earlier than that of a stop visited before it, so the planner
 *    can see what the new order would break.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:21;s:7:"endLine";i:205;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:10:"MAX_POINTS";a:12:{s:18:"declaringClassName";s:40:"App\Modules\CRM\Services\RouteSuggestion";s:21:"implementingClassName";s:40:"App\Modules\CRM\Services\RouteSuggestion";s:4:"name";s:10:"MAX_POINTS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"200";s:10:"attributes";a:6:{s:9:"startLine";i:24;s:7:"endLine";i:24;s:13:"startTokenPos";i:32;s:12:"startFilePos";i:1598;s:11:"endTokenPos";i:32;s:10:"endFilePos";i:1600;}}s:10:"docComment";s:114:"/** A route this long is checked for shortening; the plan limit is 50, so this is never reached by a real plan. */";s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:24;s:11:"startColumn";i:5;s:9:"endColumn";i:35;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:5:{s:7:"suggest";a:20:{s:4:"name";s:7:"suggest";s:10:"parameters";a:2:{s:5:"stops";a:13:{s:4:"name";s:5:"stops";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:29;s:9:"endColumn";i:40;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:5:"start";a:13:{s:4:"name";s:5:"start";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:31;s:7:"endLine";i:31;s:13:"startTokenPos";i:55;s:12:"startFilePos";i:2034;s:11:"endTokenPos";i:55;s:10:"endFilePos";i:2037;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier