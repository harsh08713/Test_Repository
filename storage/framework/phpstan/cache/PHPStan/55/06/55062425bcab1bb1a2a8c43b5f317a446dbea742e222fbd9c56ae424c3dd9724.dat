O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-b1aa60cbc4ca5aa9d6435e037a4269106efcd99625a7fdcb62de0110d2f80883";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:42:"App\Modules\Workspace\Services\TaskService";s:8:"filename";s:77:"C:/xampp/htdocs/industrial_crm/app/Modules/Workspace/Services/TaskService.php";}}s:9:"namespace";s:30:"App\Modules\Workspace\Services";s:4:"name";s:42:"App\Modules\Workspace\Services\TaskService";s:9:"shortName";s:11:"TaskService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:879:"/**
 * Task data has one door. The form and the dashboard send it the same input; the service checks it, takes care of who the task is with and
 * its history, and makes the next one of a recurring task. It does not check the permission to use a screen — the policy does that — but it
 * does check what the data allows: who a task may be given to, which records it may be about, and that a finished task stays finished.
 *
 *  - **Create** (`create`): a title, optionally a deadline, a reminder, a priority, a repeat and a record it is about.
 *  - **Edit** (`update`), **start** (`start`), **finish** (`complete`, with a note — a repeating task then makes its next one) and **call off**
 *    (`cancel`, with a reason). A task that is done or called off is a record and never changes.
 *  - **Hand over** (`reassign`): every giving is a row of the assignment history.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:382;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:8:"SUBJECTS";a:12:{s:18:"declaringClassName";s:42:"App\Modules\Workspace\Services\TaskService";s:21:"implementingClassName";s:42:"App\Modules\Workspace\Services\TaskService";s:4:"name";s:8:"SUBJECTS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:54:"['lead', 'deal', 'quotation', 'sales_order', 'ledger']";s:10:"attributes";a:6:{s:9:"startLine";i:36;s:7:"endLine";i:36;s:13:"startTokenPos";i:112;s:12:"startFilePos";i:1789;s:11:"endTokenPos";i:126;s:10:"endFilePos";i:1842;}}s:10:"docComment";s:61:"/** The records a task can be about (their morph aliases). */";s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:36;s:11:"startColumn";i:5;s:9:"endColumn";i:83;}}s:19:"immediateProperties";a:3:{s:6:"access";a:16:{s:18:"declaringClassName";s:42:"App\Modules\Workspace\Services\TaskService";s:21:"implementingClassName";s:42:"App\Modules\Workspace\Services\TaskService";s:4:"name";s:6:"access";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\Workspace\Services\TaskAccess";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:33;s:9:"endColumn";i:67;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:9:"followups";a:16:{s:18:"declaringClassName";s:42:"App\Modules\Workspace\Services\TaskService";s:21:"implementingClassName";s:42:"App\Modules\Workspace\Services\TaskService";s:4:"name";s:9:"followups";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\CRM\Services\