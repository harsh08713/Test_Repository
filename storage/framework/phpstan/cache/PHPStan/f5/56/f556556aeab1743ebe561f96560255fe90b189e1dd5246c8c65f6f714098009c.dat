O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-d45d392c577806e7f542f55869c80846665dd5d17ab09272018354e5afa5cd49";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:54:"App\Modules\Production\Services\ProductionOrderService";s:8:"filename";s:89:"C:/xampp/htdocs/industrial_crm/app/Modules/Production/Services/ProductionOrderService.php";}}s:9:"namespace";s:31:"App\Modules\Production\Services";s:4:"name";s:54:"App\Modules\Production\Services\ProductionOrderService";s:9:"shortName";s:22:"ProductionOrderService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1421:"/**
 * Production orders — the one door for their data and for everything that moves stock because of them.
 *
 *  - **Making one** (draft): an approved, active bill of materials, a quantity, dates and a branch the person works in. The components it requires are **copied from the bill** then
 *    (quantity × planned ÷ the bill's output, plus the wastage), so a later change of the bill moves nothing already planned. The order number is taken first, in the transaction.
 *  - **Releasing** puts it on the shop floor; the bill and its items must still be approved and active. The first issue or output makes it *in progress*.
 *  - **Issuing material** takes a component out of stock at the order's branch (`StockService::issue`, once per entry), up to what is required plus the company's tolerance.
 *  - **Reporting output** receives the good units into stock — at the material cost that went in, spread over the good units made so far — and records rejects with a reason. Up to the
 *    planned quantity plus the tolerance. A batch-tracked item needs a batch number (and an expiry if it has one).
 *  - **Completing** needs output; short of the plan it needs a note. **Cancelling** is only before any material was issued.
 *  - Every issue and output carries an `entry_key` (made when the form opened), so a double click or a retried request is one entry. The order row is locked first for every change.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:521;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:5:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:54:"App\Modules\Production\Services\ProductionOrderService";s:21:"implementingClassName";s:54:"App\Modules\Production\Services\ProductionOrderService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:39;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:7:"numbers";a:16:{s:18:"declaringClassName";s:54:"App\Modules\Production\Services\ProductionOrderService";s:21:"implementingClassName";s:54:"App\Modules\Production\Services\ProductionOrderService";s:4:"name";s:7:"numbers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:40;s:11:"startColumn";i:9;s:9:"endColumn";i:53;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"items";a:16:{s:18:"declaringClassName";s:54:"App\Modules\Production\Services\ProductionOrderService";s:21:"implementingClassName";s:54:"App\Modules\Production\Services\ProductionOrderService";s:4:"name";s:5:"items";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data