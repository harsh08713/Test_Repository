O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-9e4328c314f2bf8c450dc5c3bb773c3a76efa6b1d14757cf4313055f54b340ad";s:4:"data";a:24:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:36:"App\Modules\Sales\Enums\CreditResult";s:8:"filename";s:71:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Enums/CreditResult.php";}}s:9:"namespace";s:23:"App\Modules\Sales\Enums";s:4:"name";s:36:"App\Modules\Sales\Enums\CreditResult";s:9:"shortName";s:12:"CreditResult";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:1;s:12:"isBackedEnum";b:1;s:9:"modifiers";i:0;s:10:"docComment";s:833:"/**
 * The answer of the credit check an order carries: the customer's limit against what is already owed plus this order, as the company's
 * `credit_limit.behaviour` setting says to treat it.
 *
 *  - **NotChecked** — a draft that has not been checked yet.
 *  - **Ignored** — the company has switched the check off.
 *  - **NoLimit** — the customer has no credit limit on the ledger, so there is nothing to exceed.
 *  - **Ok** — within the limit.
 *  - **Warn** — over the limit, and the company's setting is to warn and allow: the order goes on, and the approver sees the warning.
 *  - **Blocked** — over the limit, and the company blocks: the order cannot be sent for approval.
 *  - **Overridden** — over the limit and blocked, but someone holding `credit_limit.override` allowed it, with a reason, audited.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:17;s:7:"endLine";i:56;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:4:"name";a:16:{s:18:"declaringClassName";s:36:"App\Modules\Sales\Enums\CreditResult";s:21:"implementingClassName";s:36:"App\Modules\Sales\Enums\CreditResult";s:4:"name";s:4:"name";s:9:"modifiers";i:2177;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";N;s:7:"endLine";N;s:11:"startColumn";i:-1;s:9:"endColumn";i:-1;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"value";a:16:{s:18:"declaringClassName";s:36:"App\Modules\Sales\Enums\CreditResult";s:21:"implementingClassName";s:36:"App\Modules\Sales\Enums\CreditResult";s:4:"name";s:5:"value";s:9:"modifiers";i:2177;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";N;s:7:"endLine";N;s:11:"startColumn";i:-1;s:9:"endColumn";i:-1;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:6:{s:5:"label";a:20:{s:4:"name";s:5:"label";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:27;s:7:"endLine";i:38;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"mo