O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-212b23fcffac6a2a0c810a30760216a63e121ec9e02c878c9032347cbe8050c3";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:36:"App\Modules\CRM\Services\LeadFilters";s:8:"filename";s:71:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/LeadFilters.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:36:"App\Modules\CRM\Services\LeadFilters";s:9:"shortName";s:11:"LeadFilters";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:513:"/**
 * The filters a lead list offers — text search, owner, branch, source, when the next follow-up is due, lead date range —
 * applied to a query. The leads screen and the mobile API both use it, so "overdue" or a search for a phone number mean
 * the same thing wherever they are asked.
 *
 * It only ever **narrows** a query: whose leads a person may see is LeadAccess::restrict(), applied first by the caller, and
 * no filter value can widen it. Anything that is not a recognisable value is ignored.
