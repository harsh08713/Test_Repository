O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-a4623c037224916b0cd3892bcfa7f86f03525e9b1feafb19e3c404a0e89abffa";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\CRM\Contracts\AchievementSource";s:8:"filename";s:78:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Contracts/AchievementSource.php";}}s:9:"namespace";s:25:"App\Modules\CRM\Contracts";s:4:"name";s:43:"App\Modules\CRM\Contracts\AchievementSource";s:9:"shortName";s:17:"AchievementSource";s:11:"isInterface";b:1;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1145:"/**
 * Where "achieved" comes from. The default policy — which Sales Orders (Phase 12) will implement — is:
 *
 *  - only **approved** orders count; drafts, pending, rejected and **cancelled** orders do not, and an approved order that
 *    is later cancelled stops counting from the moment it is cancelled;
 *  - an order counts on its **order date**, for its **owner** (the salesperson credited with it);
 *  - the value is the order total **net of tax** (after discount, before GST), so a target in rupees means sales, not tax;
 *  - an order counts **in full when approved**, whether or not it has been invoiced, delivered or paid, and a partly
 *    invoiced or partly delivered order does not count less;
 *  - **returns and credit notes** reduce the period in which they are recorded, never an earlier one;
 *  - a quantity counts in each item's **base unit**, so an "item group" target is only meaningful when its items share a unit;
 *  - the item-group and branch of a target filter the order *lines* and the order's branch.
 *
 * Until orders exist the module is bound to NullAchievementSource, which reports nothing achieved.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:20;s:7:"endLine";i:31;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:2:{s:8:"achieved";a:20:{s:4:"name";s:8:"achieved";s:10:"parameters";a:5:{s:6:"userId";a:13:{s:4:"name";s:6:"userId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:30;s:9:"endColumn";i:40;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"from";a:13:{s:4:"name";s:4:"from";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:43;s:9:"endColumn";i:54;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:2:"to";a:13:{s:4:"name";s:2:"to";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:57;s:9:"endColumn";i:66;s:14:"parameterIndex";i:2;s:10:"isOptional";b:0;}s:11:"itemGroupId";a:13:{s:4:"name";s:11:"itemGroupId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:1;a:2