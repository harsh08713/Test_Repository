O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-7d1c0c6ee79f6ab4b68824d7e4253000841fe7acc3f29c1bea7ccc5eca95ae06";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:51:"App\Modules\Api\Http\Middleware\EstablishApiContext";s:8:"filename";s:86:"C:/xampp/htdocs/industrial_crm/app/Modules/Api/Http/Middleware/EstablishApiContext.php";}}s:9:"namespace";s:31:"App\Modules\Api\Http\Middleware";s:4:"name";s:51:"App\Modules\Api\Http\Middleware\EstablishApiContext";s:9:"shortName";s:19:"EstablishApiContext";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:956:"/**
 * Runs after the device token has been accepted and settles, once, everything the rest of the request relies on — each
 * decided here on the server, whatever the app says:
 *
 *  - the account is still active (a deactivated person's tokens stop working at once, and are removed);
 *  - the account may use the API at all (`api.access`) — checked on every request, so taking the permission away takes effect
 *    without waiting for the token to expire;
 *  - the token's scope covers the call: `read` for a GET, `write` for anything that changes data (`:self` skips this for the
 *    two calls a read-only device must still make — sign out and renew);
 *  - the company: the user's default, or the one named in `X-Company-Id` — and a named company the person does not belong to
 *    is **refused**, never quietly swapped for another (that would let an app believe it is writing to one company while it
 *    writes to a different one).
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:71;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:51:"App\Modules\Api\Http\Middleware\EstablishApiContext";s:21:"implementingClassName";s:51:"App\Modules\Api\Http\Middleware\EstablishApiContext";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:2:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:6:"tenant";a:13:{s:4:"name";s:6:"tenant";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:74;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:31:"App\Modules\Api\Http\Middleware";s:18:"declaringClassName";s:51:"App\Modules\Api\Http\Middleware\EstablishApiContext";s:21:"implementingClassName";s:51:"App\Modules\A