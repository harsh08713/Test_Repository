O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-f03f4f2df42cbf858495d0e8b0ee6209dfc1c27f9a465b329509eca043914c43";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:8:"filename";s:80:"C:/xampp/htdocs/industrial_crm/app/Modules/Marketing/Services/CampaignRunner.php";}}s:9:"namespace";s:30:"App\Modules\Marketing\Services";s:4:"name";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:9:"shortName";s:14:"CampaignRunner";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1110:"/**
 * Sends the steps of running campaigns, on a schedule (`marketing:run`, every five minutes). For each member whose next step is due it:
 *
 *  1. looks at **why the sequence should end** — the person responded, the lead has moved on to a stage the campaign lists as an exit, the record is
 *     gone, they opted out or never agreed to marketing — and if so records the reason and stops;
 *  2. otherwise **holds back** if the address has already had its limit of marketing messages this week (it is tried again tomorrow, no message is made);
 *  3. otherwise asks `CommunicationService` for the message with the key `c{campaign}:m{member}:s{step}` — the same step for the same member can never
 *     produce two messages, however often this runs or crashes — and **then** moves the member on to the next step (or finishes them).
 *
 * The message is made before the member is moved on, and the move is a conditional UPDATE on the step the member was at: a crash between the two
 * leaves a message that already exists (which the next run finds by its key) and a member that is moved on once.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:167;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:5:"BATCH";a:12:{s:18:"declaringClassName";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:21:"implementingClassName";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:4:"name";s:5:"BATCH";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"200";s:10:"attributes";a:6:{s:9:"startLine";i:29;s:7:"endLine";i:29;s:13:"startTokenPos";i:70;s:12:"startFilePos";i:1598;s:11:"endTokenPos";i:70;s:10:"endFilePos";i:1600;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:29;s:11:"startColumn";i:5;s:9:"endColumn";i:30;}}s:19:"immediateProperties";a:3:{s:8:"messages";a:16:{s:18:"declaringClassName";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:21:"implementingClassName";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:4:"name";s:8:"messages";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:51:"App\Modules\Marketing\Services\CommunicationService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:9;s:9:"endColumn";i:55;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:7:"consent";a:16:{s:18:"declaringClassName";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:21:"implementingClassName";s:45:"App\Modules\Marketing\Services\CampaignRunner";s:4:"name";s:7:"consent";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:45:"App\Modules\Marketing\Services\ConsentService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes