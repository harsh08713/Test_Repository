O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-c9bdc7c1be6da3841f79cceec68684a81c92cfddd1d77fd05ae9060743bfc347";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:38:"App\Modules\Sales\Services\CreditCheck";s:8:"filename";s:73:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/CreditCheck.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:38:"App\Modules\Sales\Services\CreditCheck";s:9:"shortName";s:11:"CreditCheck";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:966:"/**
 * The credit check a sales order carries: this customer's credit limit against what is already out plus this order, treated as the company's
 * `credit_limit.behaviour` setting says (warn and allow, block, or do not check).
 *
 * **What "already out" means here — and the assumption behind it.** There is no receivables ledger or payment recording yet (accounting is
 * not in scope), so the system cannot know what a customer has actually paid. Instead it counts the customer's *other* orders that are waiting
 * for approval or approved, not cancelled, and whose order date is still inside the customer's **credit days** (ledger field): goods sold on
 * credit are treated as unpaid until their credit period is over. A customer with no credit days is counted for the orders of today only.
 * A customer whose ledger has no credit limit (or a limit of zero) has nothing to exceed. When payments are recorded (a later phase) only
 * `exposure()` changes.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:23;s:7:"endLine";i:111;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:8:"settings";a:16:{s:18:"declaringClassName";s:38:"App\Modules\Sales\Services\CreditCheck";s:21:"implementingClassName";s:38:"App\Modules\Sales\Services\CreditCheck";s:4:"name";s:8:"settings";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Services\SettingsService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:25;s:11:"startColumn";i:33;s:9:"endColumn";i:74;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:6:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:8:"settings";a:13:{s:4:"name";s:8:"settings";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Services\SettingsService";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:25;s:11:"startColumn";i:33;s:9:"endColumn";i:74;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:25;s:7:"endLine";i:25;s:11:"startColumn";i:5;s:9:"endColumn";i:78;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:26:"App\Modules\Sales\Services";s:18:"declaringClassName";s:38:"App\Modules\Sales\Services\CreditCheck";s:21:"implementingClassName";s:38:"App\Modules\Sales\Services\CreditCheck";s: