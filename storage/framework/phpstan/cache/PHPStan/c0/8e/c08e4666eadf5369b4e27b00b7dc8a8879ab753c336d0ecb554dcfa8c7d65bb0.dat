O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-1ce597ad8f1c954151774bd480107736b632d58582cef61df00eb4dab5c62642";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:46:"App\Modules\Marketing\Services\CampaignService";s:8:"filename";s:81:"C:/xampp/htdocs/industrial_crm/app/Modules/Marketing/Services/CampaignService.php";}}s:9:"namespace";s:30:"App\Modules\Marketing\Services";s:4:"name";s:46:"App\Modules\Marketing\Services\CampaignService";s:9:"shortName";s:15:"CampaignService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:883:"/**
 * Campaign data has one door. The form sends it what was typed; the service checks it (owner in reach, branch the person works in, dates, budget, the
 * audience definition, steps that use real templates), takes the CP number first, and saves the campaign and its steps together.
 *
 *  - **Make / change** (`create`, `update`): only while it is a draft; once it is sent for approval it is fixed — in the model as well.
 *  - **Launch** (`launch`): an approved draft only, once. The audience is worked out **now, with the reach of the campaign's owner**, and frozen into
 *    members (the name and the contact details are copied: the campaign writes to what it was approved to write to).
 *  - **Pause, resume, call off**; **mark a member as having responded** (which ends their sequence).
 *
 * Sending is not here: `CampaignRunner` does it, step by step, on a schedule.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:395;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:5:"TYPES";a:12:{s:18:"declaringClassName";s:46:"App\Modules\Marketing\Services\CampaignService";s:21:"implementingClassName";s:46:"App\Modules\Marketing\Services\CampaignService";s:4:"name";s:5:"TYPES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:214:"['email' => 'E-mail', 'whatsapp' => 'WhatsApp', 'sms' => 'SMS', 'multichannel' => 'More than one channel', 'event' => 'Event or exhibition', 'referral' => 'Referral', 'social' => 'Social media', 'other' => 'Other']";s:10:"attributes";a:6:{s:9:"startLine";i:37;s:7:"endLine";i:37;s:13:"startTokenPos";i:115;s:12:"startFilePos";i:1753;s:11:"endTokenPos";i:170;s:10:"endFilePos";i:1966;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:37;s:7:"endLine";i:37;s:11:"startColumn";i:5;s:9:"endColumn";i:240;}s:9:"MAX_STEPS";a:12:{s:18:"declaringClassName";s:46:"App\Modules\Marketing\Services\CampaignService";s:21:"implementingClassName";s:46:"App\Modules\Marketing\Services\CampaignService";s:4:"name";s:9:"MAX_STEPS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"10";s:10:"attributes";a:6:{s:9:"startLine";i:39;s:7:"endLine";i:39;s:13:"startTokenPos";i:181;s:12:"startFilePos";i:1999;s:11:"endTokenPos";i:181;s:10:"endFilePos";i:2000;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:39;s:11:"startColumn";i:5;s:9:"endColumn";i:32;}}s:19:"immediateProperties";a:4:{s:7:"numbers";a:16:{s:18:"declaringClassName";s:46:"App\Modules\Marketing\Services\CampaignService";s:21:"implementingClassName";s:46:"App\Modules\Marketing\Services\CampaignService";s:4:"name";s:7:"numbers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Sh