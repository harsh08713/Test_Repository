O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-edce6bb380aba7b42916b11375e8f0e7b50b18f6ef9b66cfc2d60c13e1f21f6d";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\CRM\Services\FollowupService";s:8:"filename";s:75:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/FollowupService.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:40:"App\Modules\CRM\Services\FollowupService";s:9:"shortName";s:15:"FollowupService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1419:"/**
 * Plans follow-ups on a lead and records what came of them. The single gate for follow-up data (the lead page, the
 * calendar and later the mobile API share it); it does not decide who may (LeadPolicy::followUp and FollowupPolicy do).
 *
 *  - **Plan** (`schedule`): a time in the future, a type, and who is to do it — the lead's owner by default; otherwise the
 *    person planning it or someone they manage, who must work in the lead's branch. Only an open lead gets new follow-ups.
 *  - **Done** (`complete`): needs an outcome from the master. An outcome that "needs a next follow-up" (Call Back Later,
 *    Meeting Fixed) is refused without a date for it, and the next one is planned in the same step, linked to this one.
 *    An outcome that "counts as contact" stamps the lead as contacted now and moves a *new* lead to *contacted*.
 *  - **Log** (`log`): something that was just done without having been planned — recorded as done, with the same rules.
 *  - **Move** (`reschedule`) and **call off** (`cancel`, with a reason) apply to planned follow-ups only; a follow-up that
 *    is done is a record of what happened and never changes.
 *
 * After every change the lead's "next follow-up" is brought back in step. Reminding the person, and telling their
 * manager when a follow-up has been left overdue, is the scheduler's job (`crm:followup-reminders`): moving a follow-up
 * re-arms both.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:391;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:14:"MAX_DAYS_AHEAD";a:12:{s:18:"declaringClassName";s:40:"App\Modules\CRM\Services\FollowupService";s:21:"implementingClassName";s:40:"App\Modules\CRM\Services\FollowupService";s:4:"name";s:14:"MAX_DAYS_AHEAD";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"730";s:10:"attributes";a:6:{s:9:"startLine";i:39;s:7:"endLine";i:39;s:13:"startTokenPos";i:92;s:12:"startFilePos";i:2074;s:11:"endTokenPos";i:92;s:10:"endFilePos";i:2076;}}s:10:"docComment";s:48:"/** How far ahead a follow-up may be planned. */";s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:39;s:11:"startColumn";i:5;s:9:"endColumn";i:38;}}s:19:"immediateProperties";a:3:{s:5:"scope";a:16:{s:18:"declaringClassName";s:40:"App\Modules\CRM\Services\FollowupService";s:21:"implementingClassName";s:40:"App\Modules\CRM\Services\FollowupService";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:42;s:7:"endLine";i:42;s:11:"startColumn";i:9;s:9:"endColumn";i:42;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"teams";a:16:{s:18:"declaringClassName";s:40:"App\Modules\CRM\Services\FollowupService";s:21:"implementingClassName";s:40:"App\Modules\CRM\Services\FollowupService";s:4:"name";s:5:"teams";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\CRM\Services\SalesTeamService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s: