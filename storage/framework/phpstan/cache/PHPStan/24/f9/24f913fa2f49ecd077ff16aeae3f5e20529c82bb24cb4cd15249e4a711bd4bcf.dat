 * The one way a transaction finds what an item costs.
 *
 * `getRate()` returns a rate only if it is **approved, active and effective on the date asked**, for an approved,
 * active item, in a unit the item has, at a branch the caller may use, in the caller's company. Anything else is a
 * `RateNotFoundException` that says why — it never quietly falls back to an unapproved, expired or other branch's
 * rate, never converts between units, and never guesses.
 *
 * Which rate wins:
 *  1. The requested price list's own rate; if it has none and `$fallbackToStandard` is true, the standard rate
 *     (the quote says which one it used). With no price list asked for, only the standard rate is considered.
 *  2. Periods are inclusive at both ends ("effective on 31 Mar" includes a rate ending 31 Mar).
 *  3. Overlapping live rates for one slot cannot be created, so at most one rate qualifies. Should data ever
 *     contain two anyway, the tie is broken the same way every time — the later `effective_from`, then the more
 *     recently approved, then the higher id — rather than arbitrarily.
 *
 * Changing a looked-up rate on a quotation or order is a separate, permissioned and audited act: `recordOverride()`.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:239;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:5:{s:7:"getRate";a:20:{s:4:"name";s:7:"getRate";s:10:"parameters";a:6:{s:4:"item";a:13:{s:4:"name";s:4:"item";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:31:"App\Modules\Masters\Models\Item";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:47;s:7:"endLine";i:47;s:11:"startColumn";i:9;s:9:"endColumn";i:22;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:8:"location";a:13:{s:4:"name";s:8:"location";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:34:"App\Modules\Shared\Models\Location";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:9;s:9:"endColumn";i:30;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:3:"uom";a:13:{s:4:"name";s:3:"uom";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a