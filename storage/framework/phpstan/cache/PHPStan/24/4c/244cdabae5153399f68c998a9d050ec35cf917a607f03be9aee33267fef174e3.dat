O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-9305c50b0a89493aea21e4ce2739b0ce463072192baf8016c07237f420a40e15";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:39:"App\Modules\Workspace\Services\SlaSweep";s:8:"filename";s:74:"C:/xampp/htdocs/industrial_crm/app/Modules/Workspace/Services/SlaSweep.php";}}s:9:"namespace";s:30:"App\Modules\Workspace\Services";s:4:"name";s:39:"App\Modules\Workspace\Services\SlaSweep";s:9:"shortName";s:8:"SlaSweep";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1108:"/**
 * The SLA engine. One pass (`sla:check`, every five minutes) does four things for every company, and every step is safe to repeat:
 *
 *  1. **Start** a clock for each lead, planned follow-up and task that a policy covers and that has none.
 *  2. **Settle** the running clocks from the facts: a lead that has been contacted, a follow-up that was done, a task that was finished have
 *     *met* theirs (at the moment it happened, so being late shows even if the sweep ran later); a lead that was won or lost, a follow-up or
 *     task called off or moved, a lead handed to somebody else have *stopped* theirs — and a handed-over lead gets a fresh clock.
 *  3. **Notice** the clocks that ran out: claim the breach with one conditional UPDATE, write it in the breach log, tell the person (and
 *     their manager when the policy escalates) once, and leave an audit entry.
 *
 * Nothing is reassigned automatically: an escalation tells a manager, it does not move work. Facts are read, never trusted from the screens, so a
 * change made by an import, the API or a script is settled the same way.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:517;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:5:"BATCH";a:12:{s:18:"declaringClassName";s:39:"App\Modules\Workspace\Services\SlaSweep";s:21:"implementingClassName";s:39:"App\Modules\Workspace\Services\SlaSweep";s:4:"name";s:5:"BATCH";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4:"2000";s:10:"attributes";a:6:{s:9:"startLine";i:42;s:7:"endLine";i:42;s:13:"startTokenPos";i:130;s:12:"startFilePos";i:2064;s:11:"endTokenPos";i:130;s:10:"endFilePos";i:2067;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:42;s:7:"endLine";i:42;s:11:"startColumn";i:5;s:9:"endColumn";i:31;}s:17:"START_WINDOW_DAYS";a:12:{s:18:"declaringClassName";s:39:"App\Modules\Workspace\Services\SlaSweep";s:21:"implementingClassName";s:39:"App\Modules\Workspace\Services\SlaSweep";s:4:"name";s:17:"START_WINDOW_DAYS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"30";s:10:"attributes";a:6:{s:9:"startLine";i:45;s:7:"endLine";i:45;s:13:"startTokenPos";i:143;s:12:"startFilePos";i:2239;s:11:"endTokenPos";i:143;s:10:"endFilePos";i:2240;}}s:10:"docComment";s:125:"/** Things older than this are not given a clock when a sweep finds them without one (a policy is not retroactive anyway). */";s:10:"attributes";a:0:{}s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:5;s:9:"endColumn";i:41;}}s:19:"immediateProperties";a:4:{s:9:"teamCache";a:16:{s:18:"declaringClassName";s:39:"App\Modules\Workspace\Services\SlaSweep";s:21:"implementingClassName";s:39:"App\Modules\Workspace\Services\SlaSweep";s:4:"name";s:9:"teamCache";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default";a:2:{s:4:"code";s:2:"[]";s:10:"attributes";a:6:{s:9:"startLine";i:48;s: