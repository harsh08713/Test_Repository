O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-9baa1056baabc5402dd4c41f57f32a0d987e46e084463bc7762b712fa4765b16";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Api\Services\DeviceTokenService";s:8:"filename";s:78:"C:/xampp/htdocs/industrial_crm/app/Modules/Api/Services/DeviceTokenService.php";}}s:9:"namespace";s:24:"App\Modules\Api\Services";s:4:"name";s:43:"App\Modules\Api\Services\DeviceTokenService";s:9:"shortName";s:18:"DeviceTokenService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:944:"/**
 * Signs a device in and out. A device is a Sanctum token: revocable one by one, expiring, and listed for the person who owns it.
 *
 *  - **Sign in** checks the password (the same account rules as the web: active users only; the unknown-user path does the
 *    same work as the known one, so timing does not reveal which e-mail addresses exist), then that the person may use the API
 *    at all, and issues a token carrying only the scopes asked for (`read`, `write`; both by default).
 *  - A device that signs in again with the same `device_id` **replaces** its old token; beyond `max_devices` the device used
 *    least recently is signed out. So a lost phone's token cannot pile up unnoticed, and a person's list stays short.
 *  - **Renew** swaps the token for a new one (same device, same scopes) and revokes the old.
 *  - Issuing and revoking are audited — who, which device, from where — and **never** the token itself.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:150;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:10:"DUMMY_HASH";a:12:{s:18:"declaringClassName";s:43:"App\Modules\Api\Services\DeviceTokenService";s:21:"implementingClassName";s:43:"App\Modules\Api\Services\DeviceTokenService";s:4:"name";s:10:"DUMMY_HASH";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:62:"'$2y$12$YPRSEi165LX80mYjx7cPVuP3ewanEjDe26CEPgPPOuYVxjsdyIFRi'";s:10:"attributes";a:6:{s:9:"startLine";i:28;s:7:"endLine";i:28;s:13:"startTokenPos";i:67;s:12:"startFilePos";i:1477;s:11:"endTokenPos";i:67;s:10:"endFilePos";i:1538;}}s:10:"docComment";s:121:"/** The bcrypt hash of a password nobody has, checked when the e-mail address is unknown so the work done is the same. */";s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:94;}}s:19:"immediateProperties";a:1:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Api\Services\DeviceTokenService";s:21:"implementingClassName";s:43:"App\Modules\Api\Services\DeviceTokenService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:30;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:6:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:6:"tenant";a:13:{s:4:"name";s:6:"tenant";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modu