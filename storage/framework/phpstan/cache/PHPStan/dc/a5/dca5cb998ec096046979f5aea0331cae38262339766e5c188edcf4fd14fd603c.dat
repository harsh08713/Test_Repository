 * Quotations over the API — **read only**. A quotation is priced, taxed, approved, sent and revised on the screens, through
 * QuotationService; the app lists and shows them so a salesperson can look at what a customer was offered.
 *
 *  - **What a person sees** is QuotationAccess (those of their own leads, their team's, everyone's for `sales.scope_all`, and the ones an
 *    approver is asked about). Anything else is a 404.
 *  - **Sync.** `updated_since` returns everything changed at or after that moment, in change order; `meta.server_time` is the value to
 *    send next time. (A quotation is never deleted, so there is nothing to drop.)
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:69;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:46:"App\Modules\Api\Http\Controllers\ApiController";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:4:"WITH";a:12:{s:18:"declaringClassName";s:52:"App\Modules\Api\Http\Controllers\QuotationController";s:21:"implementingClassName";s:52:"App\Modules\Api\Http\Controllers\QuotationController";s:4:"name";s:4:"WITH";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:103:"['location:id,code,name', 'deal:id,deal_number', 'priceList:id,name', 'placeOfSupply:id,name,gst_code']";s:10:"attributes";a:6:{s:9:"startLine";i:26;s:7:"endLine";i:26;s:13:"startTokenPos";i:72;s:12:"startFilePos";i:1170;s:11:"endTokenPos";i:83;s:10:"endFilePos";i:1272;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:26;s:11:"startColumn";i:5;s:9:"endColumn";i:129;}s:6:"DETAIL";a:12:{s:18:"declaringClassName";s:52:"App\Modules\Api\Http\Controllers\QuotationController";s:21:"implementingClassName";s:52:"App\Modules\Api\Http\Controllers\QuotationController";s:4:"name";s:6:"DETAIL";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:67:"[...self::WITH, 'items.unit:id,code', 'stateHistory.actor:id,name']";s:10:"attributes";a:6:{s:9:"startLine";i:28;s:7:"endLine";i:28;s:13:"startTokenPos";i:94;s:12:"startFilePos";i:1303;s:11:"endTokenPos";i:105;s:10:"endFilePos";i:1369;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:95;}}s:19:"immediateProperties";a:1:{s:6:"access";a:16:{s:18:"declaringClassName";s:52:"App\Modules\Api\Http\Controllers\QuotationController";s:21:"implementingClassName";s:52:"App\Modules\Api\Http\Controllers\QuotationController";s:4:"name";s:6:"access";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s: