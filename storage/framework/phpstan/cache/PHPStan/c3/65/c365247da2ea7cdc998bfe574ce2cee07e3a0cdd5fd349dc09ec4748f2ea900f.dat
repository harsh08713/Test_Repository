 * Whose deals a person may see and work — the one rule the policy, the lists, the reassignment and (later) the API share.
 *
 * A deal always has an owner (the lead's owner when it was converted), so there is no pool:
 *  - **Work** (change it, move its stage, hand it over): its owner, the people who manage them, and holders of
 *    `sales.scope_all` (SalesScope).
 *  - **See** (open it): everyone who may work it, and an approver for a deal waiting for their decision or one they have
 *    decided (ApproverReach).
 *
 * The company and branch boundaries are not decided here: every deal query already runs through the tenant scopes.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:20;s:7:"endLine";i:91;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:5:"scope";a:16:{s:18:"declaringClassName";s:35:"App\Modules\CRM\Services\DealAccess";s:21:"implementingClassName";s:35:"App\Modules\CRM\Services\DealAccess";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:22;s:11:"startColumn";i:33;s:9:"endColumn";i:66;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:9:"approvers";a:16:{s:18:"declaringClassName";s:35:"App\Modules\CRM\Services\DealAccess";s:21:"implementingClassName";s:35:"App\Modules\CRM\Services\DealAccess";s:4:"name";s:9:"approvers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:38:"App\Modules\CRM\Services\ApproverReach";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:22;s:11:"startColumn";i:69;s:9:"endColumn";i:109;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:6:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:5:"scope";a:13:{s:4:"name";s:5:"scope";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes