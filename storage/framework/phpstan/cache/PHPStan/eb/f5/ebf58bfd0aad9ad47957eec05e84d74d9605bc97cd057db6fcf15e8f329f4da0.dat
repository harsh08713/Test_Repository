O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-a79ef25068cf9dae24789272625ad6406db969fe95a26e9be9fb9f6a7778c77a";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:51:"App\Modules\Sales\Services\QuotationConversionGuard";s:8:"filename";s:86:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/QuotationConversionGuard.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:51:"App\Modules\Sales\Services\QuotationConversionGuard";s:9:"shortName";s:24:"QuotationConversionGuard";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:857:"/**
 * Whether a quotation may become a sales order (Phase 12 asks before it makes one). A sales order is **not** required to come from a
 * quotation — an approved deal can be ordered without one — so this guard only applies when the order *is* made from a quotation.
 *
 * Two kinds of "no":
 *  - **Hard** — never waived: it is not the latest revision, it is draft, declined, cancelled or superseded, it is not approved, or its
 *    deal is no longer open. These mean the document is not a standing offer at all.
 *  - **Soft** — what a salesperson sometimes has to override: the customer has not formally accepted it (it is only Sent), or it has run
 *    past its valid-until date. Someone holding `quotation.convert_exception` may go ahead with a **reason**; the exception is audited
 *    on the quotation and the order carries the note.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:103;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:2:{s:6:"blocks";a:20:{s:4:"name";s:6:"blocks";s:10:"parameters";a:1:{s:9:"quotation";a:13:{s:4:"name";s:9:"quotation";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:34:"App\Modules\Sales\Models\Quotation";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:28;s:9:"endColumn";i:47;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:64:"/**
