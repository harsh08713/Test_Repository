O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-aa716360dfdef9004646df204847db5dbeea5bb138025ab9e39dc688f1acab7c";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:51:"App\Modules\Marketing\Services\CommunicationService";s:8:"filename";s:86:"C:/xampp/htdocs/industrial_crm/app/Modules/Marketing/Services/CommunicationService.php";}}s:9:"namespace";s:30:"App\Modules\Marketing\Services";s:4:"name";s:51:"App\Modules\Marketing\Services\CommunicationService";s:9:"shortName";s:20:"CommunicationService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:920:"/**
 * The one door through which a message to a person is made — by a campaign, a workflow or a person. Making a message does not send it: it decides
 * what is to happen to it and writes that down.
 *
 *  - Only an **approved, active** template is used, and what is sent is the template filled in, kept exactly as it went out.
 *  - The **idempotency key** (`c{campaign}:m{member}:s{step}`, `w{run}:a{action}`…) is unique, so asking twice for the same message gives the same message.
 *  - **Consent** is checked (`ConsentService`) and a **frequency cap** applied to marketing; a message that fails either is *kept* as `suppressed`, with the reason.
 *  - A channel with **no provider connected** keeps the message as `not_connected` — never "sent".
 *  - Otherwise it is `queued` and `SendCommunication` hands it to the mail server. `sent` means the mail server accepted it; nothing claims it was delivered.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:233;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:8:"CAP_DAYS";a:12:{s:18:"declaringClassName";s:51:"App\Modules\Marketing\Services\CommunicationService";s:21:"implementingClassName";s:51:"App\Modules\Marketing\Services\CommunicationService";s:4:"name";s:8:"CAP_DAYS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"7";s:10:"attributes";a:6:{s:9:"startLine";i:38;s:7:"endLine";i:38;s:13:"startTokenPos";i:122;s:12:"startFilePos";i:1927;s:11:"endTokenPos";i:122;s:10:"endFilePos";i:1927;}}s:10:"docComment";s:71:"/** An address's marketing messages are counted over this many days. */";s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:5;s:9:"endColumn";i:30;}s:12:"MAX_ATTEMPTS";a:12:{s:18:"declaringClassName";s:51:"App\Modules\Marketing\Services\CommunicationService";s:21:"implementingClassName";s:51:"App\Modules\Marketing\Services\CommunicationService";s:4:"name";s:12:"MAX_ATTEMPTS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"3";s:10:"attributes";a:6:{s:9:"startLine";i:41;s:7:"endLine";i:41;s:13:"startTokenPos";i:135;s:12:"startFilePos";i:2030;s:11:"endTokenPos";i:135;s:10:"endFilePos";i:2030;}}s:10:"docComment";s:62:"/** Failed messages are tried again this many times in all. */";s:10:"attributes";a:0:{}s:9:"startLine";i:41;s:7:"endLine";i:41;s:11:"startColumn";i:5;s:9:"endColumn";i:34;}}s:19:"immediateProperties";a:4:{s:7:"consent";a:16:{s:18:"declaringClassName";s:51:"App\Modules\Marketing\Services\CommunicationService";s:21:"implementingClassName";s:51:"App\Modules\Marketing\Services\CommunicationService";s:4:"name";s:7:"consent";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:45:"App\Modules\Marketing\Services\ConsentServ