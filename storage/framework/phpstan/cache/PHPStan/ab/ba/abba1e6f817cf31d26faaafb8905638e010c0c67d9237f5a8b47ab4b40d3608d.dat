O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-7b7759eb4715dc749cc40136ab97bc386b71354f96f08c190fda7aedf7a47539";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:42:"App\Modules\CRM\Services\AttendanceService";s:8:"filename";s:77:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/AttendanceService.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:42:"App\Modules\CRM\Services\AttendanceService";s:9:"shortName";s:17:"AttendanceService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1473:"/**
 * Marks attendance — the one rule everything else in this phase hangs on: **no route plan, no attendance**.
 *
 * `mark()` is what a person's own phone or browser calls. The server decides everything, in this order, and the first
 * failure refuses the attempt, writes it to the violation log and tells the person why:
 *
 *  1. today is not already marked (that is not a violation: it is just refused);
 *  2. FieldPositionGate (shared with saving a lead from the field) finds today's route plan — no plan, a draft, or a
 *     cancelled one all mean "no route plan" — and checks that the reported position is a real one, accurate enough, and
 *     inside the geofence of a stop of that plan (GeofenceService — nothing the client worked out is trusted).
 *
 * Only then is an attendance record written, with the **server's** clock, the position, accuracy, distance and radius
 * that decided it. The record is append-only. One record per person and day (a unique key backs it).
 *
 * `overrideViolation()` is the only other way in: where a manager has switched the override on for the company and holds
 * the `geofence.override` permission, they can accept a refused attempt of someone they manage (never their own), with a
 * reason, within a week. It does not erase the violation — a new record points back at it — and it is audited.
 *
 * Time and place come from the caller only as a position and an accuracy: `$at` exists for seeding and tests.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:190;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:20:"OVERRIDE_WINDOW_DAYS";a:12:{s:18:"declaringClassName";s:42:"App\Modules\CRM\Services\AttendanceService";s:21:"implementingClassName";s:42:"App\Modules\CRM\Services\AttendanceService";s:4:"name";s:20:"OVERRIDE_WINDOW_DAYS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"7";s:10:"attributes";a:6:{s:9:"startLine";i:46;s:7:"endLine";i:46;s:13:"startTokenPos";i:112;s:12:"startFilePos";i:2404;s:11:"endTokenPos";i:112;s:10:"endFilePos";i:2404;}}s:10:"docComment";s:63:"/** How long after an attempt a manager can still accept it. */";s:10:"attributes";a:0:{}s:9:"startLine";i:46;s:7:"endLine";i:46;s:11:"startColumn";i:5;s:9:"endColumn";i:42;}}s:19:"immediateProperties";a:3:{s:8:"settings";a:16:{s:18:"declaringClassName";s:42:"App\Modules\CRM\Services\AttendanceService";s:21:"implementingClassName";s:42:"App\Modules\CRM\Services\AttendanceService";s:4:"name";s:8:"settings";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Services\SettingsService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:49;s:7:"endLine";i:49;s:11:"startColumn";i:9;s:9:"endColumn";i:50;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:4:"gate";a:16:{s:18:"declaringClassName";s:42:"App\Modules\CRM\Services\AttendanceService";s:21:"implementingClassName";s:42:"App\Modules\CRM\Services\AttendanceService";s:4:"name";s:4:"gate";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:42:"App\Modules\CRM\Services\FieldPositionGate";s:12:"isIden