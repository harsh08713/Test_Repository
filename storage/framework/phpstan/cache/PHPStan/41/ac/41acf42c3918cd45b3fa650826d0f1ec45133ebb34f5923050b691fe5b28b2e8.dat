 * Drives one uploaded file through upload → check → (confirm) → apply, whatever the file contains.
 *
 * - Every transition is one atomic conditional UPDATE, so a double click or a duplicate queue delivery can never
 *   start the same phase twice.
 * - The check is a dry run of the very same row logic the apply uses; nothing is written until someone confirms.
 * - Rows that fail are skipped and listed (with the original cells) in `import_batch_errors`; rows that pass are
 *   applied in chunks, each in one transaction, and each row inside a savepoint. Because importers are idempotent,
 *   a failed run is safely retried.
 * - Bulk imports write one summary audit entry instead of one per created row.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:503;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:9:"importers";a:16:{s:18:"declaringClassName";s:39:"App\Modules\Shared\Imports\ImportRunner";s:21:"implementingClassName";s:39:"App\Modules\Shared\Imports\ImportRunner";s:4:"name";s:9:"importers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Imports\ImporterRegistry";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:33;s:9:"endColumn";i:76;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:17:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:9:"importers";a:13:{s:4:"name";s:9:"importers";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Imports\ImporterRegistry";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:33;s:9:"endColumn";i:76;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:5;s:9:"endColumn";i:80;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:26:"App\Modules\Shared\Imports";s:18:"declaringClassName";s:39:"App\Modules\Shared\Imports\ImportRunner";s:21:"implementingClassName";s:39:"App\Modules\Shared\Imports\ImportR