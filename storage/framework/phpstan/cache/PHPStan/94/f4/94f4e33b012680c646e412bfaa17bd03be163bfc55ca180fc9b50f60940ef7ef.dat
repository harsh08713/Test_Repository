O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-d280ebb001a3f6297095a4ded86e95a0965b9e1cf7fb8f43217c018650a0cc5f";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:42:"App\Modules\Workspace\Services\Customer360";s:8:"filename";s:77:"C:/xampp/htdocs/industrial_crm/app/Modules/Workspace/Services/Customer360.php";}}s:9:"namespace";s:30:"App\Modules\Workspace\Services";s:4:"name";s:42:"App\Modules\Workspace\Services\Customer360";s:9:"shortName";s:11:"Customer360";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1086:"/**
 * Everything the company knows about one customer, in one place — for the person looking, and only what they may already see elsewhere.
 *
 * Each section is read through the access class of its own screen (`LeadAccess`, `DealAccess`, `QuotationAccess`, `SalesOrderAccess`,
 * `FollowupAgenda`, `TaskAccess`), so a salesperson sees their own leads, deals, quotations and orders for this customer, a manager their team's, an
 * administrator all of them — and a section the person has no right to at all (no `deal.view`) is left out. The customer's master record and
 * contacts follow the Ledger screen (`ledger.view`); **bank details never appear here**.
 *
 * What is linked: records whose customer is this ledger (inquiries, deals, quotations, orders, invoices), and the leads that became those deals.
 * A new lead that was never tied to a customer record is not found by name or phone number — it is not this customer until somebody links it.
 * Sections that need later phases (communications, campaign attribution, documents, support tickets) are named, not faked.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:218;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:4:"LIST";a:12:{s:18:"declaringClassName";s:42:"App\Modules\Workspace\Services\Customer360";s:21:"implementingClassName";s:42:"App\Modules\Workspace\Services\Customer360";s:4:"name";s:4:"LIST";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"8";s:10:"attributes";a:6:{s:9:"startLine";i:42;s:7:"endLine";i:42;s:13:"startTokenPos";i:132;s:12:"startFilePos";i:2115;s:11:"endTokenPos";i:132;s:10:"endFilePos";i:2115;}}s:10:"docComment";s:69:"/** How many of each kind are listed; the total is always counted. */";s:10:"attributes";a:0:{}s:9:"startLine";i:42;s:7:"endLine";i:42;s:11:"startColumn";i:5;s:9:"endColumn";i:26;}}s:19:"immediateProperties";a:7:{s:5:"leads";a:16:{s:18:"declaringClassName";s:42:"App\Modules\Workspace\Services\Customer360";s:21:"implementingClassName";s:42:"App\Modules\Workspace\Services\Customer360";s:4:"name";s:5:"leads";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\LeadAccess";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:9;s:9:"endColumn";i:42;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"deals";a:16:{s:18:"declaringClassName";s:42:"App\Modules\Workspace\Services\Customer360";s:21:"implementingClassName";s:42:"App\Modules\Workspace\Services\Customer360";s:4:"name";s:5:"deals";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\DealAccess";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment"