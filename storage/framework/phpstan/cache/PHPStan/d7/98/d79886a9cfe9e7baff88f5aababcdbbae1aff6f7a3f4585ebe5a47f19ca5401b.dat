 * Creates and changes ledgers together with their addresses, contacts and bank details.
 *
 * It is the single gate for ledger data: whatever calls it (the form, a seeder, a future import) gets the same
 * validation, normalisation and rules, and everything is written in one transaction. It does not decide who may
 * do it (policies do) and it does not submit for approval (ApprovalService does).
 *
 * Input shape (the same paths the form binds to, so errors line up with the screen):
 *   ledger    => code, name, legal_name, account_group_id, customer_kind, gstin, pan, email, phone, credit_days,
 *                credit_limit, lead_time_days, payment_preferences[], status, remarks
 *   addresses => [ id?, label, is_billing, is_shipping, is_default_billing, is_default_shipping, line1, line2, city,
 *                  state_id, district_id, pin_code, gstin, phone ]
 *   contacts  => [ id?, name, designation, phone, mobile, email, is_primary ]
 *   bank      => null | [ bank_name, branch, account_holder, account_type, account_number, ifsc ]
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:639;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:8:"MAX_ROWS";a:12:{s:18:"declaringClassName";s:42:"App\Modules\Masters\Services\LedgerService";s:21:"implementingClassName";s:42:"App\Modules\Masters\Services\LedgerService";s:4:"name";s:8:"MAX_ROWS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"25";s:10:"attributes";a:6:{s:9:"startLine";i:45;s:7:"endLine";i:45;s:13:"startTokenPos";i:135;s:12:"startFilePos";i:2058;s:11:"endTokenPos";i:135;s:10:"endFilePos";i:2059;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:5;s:9:"endColumn";i:31;}s:13:"ACCOUNT_TYPES";a:12:{s:18:"declaringClassName";s:42:"App\Modules\Masters\Services\LedgerService";s:21:"implementingClassName";s:42:"App\Modules\Masters\Services\LedgerService";s:4:"name";s:13:"ACCOUNT_TYPES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:108:"['current' => 'Current', 'savings' => 'Savings', 'cash_credit' => 'Cash credit', 'overdraft' => 'Overdraft']";s:10:"attributes";a:6:{s:9:"startLine";i:47;s:7:"endLine";i:47;s:13:"startTokenPos";i:146;s:12:"startFilePos";i:2096;s:11:"endTokenPos";i:173;s:10:"endFilePos";i:2203;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:47;s:7:"endLine";i:47;s:11:"startColumn";i:5;s:9:"endColumn";i:142;}}s:19:"immediateProperties";a:1:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:42:"App\Modules\Masters\Services\LedgerService";s:21:"implementingClassName";s:42:"App\Modules\Masters\Services\LedgerService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s: