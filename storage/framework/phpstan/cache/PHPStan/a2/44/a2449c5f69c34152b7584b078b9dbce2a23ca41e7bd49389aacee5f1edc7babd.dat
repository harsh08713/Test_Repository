 * Decides whether a restored copy of the database is a faithful one, by comparing it with the live database table by table. Pure: it is given the numbers and returns a verdict.
 *
 *  - **FAIL**: a live table is missing from the restore, a table has a different number of columns, or the restore has no rows where the live table has some.
 *  - **WARN**: the restore has fewer rows than live (the live database has grown since the backup: normal) or more (rows were removed since: worth a look).
 *  - **OK**: the same number of rows.
 *  - Tables that change by themselves (sessions, cache, jobs) are listed but never judged.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:13;s:7:"endLine";i:70;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:8:"VOLATILE";a:12:{s:18:"declaringClassName";s:45:"App\Modules\Shared\Services\RestoreComparison";s:21:"implementingClassName";s:45:"App\Modules\Shared\Services\RestoreComparison";s:4:"name";s:8:"VOLATILE";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:99:"['sessions', 'cache', 'cache_locks', 'jobs', 'job_batches', 'failed_jobs', 'password_reset_tokens']";s:10:"attributes";a:6:{s:9:"startLine";i:16;s:7:"endLine";i:16;s:13:"startTokenPos";i:27;s:12:"startFilePos";i:798;s:11:"endTokenPos";i:47;s:10:"endFilePos";i:896;}}s:10:"docComment";s:50:"/** Tables whose rows come and go on their own. */";s:10:"attributes";a:0:{}s:9:"startLine";i:16;s:7:"endLine";i:16;s:11:"startColumn";i:5;s:9:"endColumn";i:128;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:7:"compare";a:20:{s:4:"name";s:7:"compare";s:10:"parameters";a:2:{s:4:"live";a:13:{s:4:"name";s:4:"live";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:36;s:9:"endColumn";i:46;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:8:"restored";a:13:{s:4:"name";s:8:"restored";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:49;s:9:"endColumn";i:63;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType