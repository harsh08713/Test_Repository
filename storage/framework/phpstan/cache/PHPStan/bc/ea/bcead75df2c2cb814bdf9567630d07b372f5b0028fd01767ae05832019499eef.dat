 * Makes a create (or any change) safe to send twice. The app sends `Idempotency-Key: <a fresh UUID per action>`; the first
 * request runs and its successful answer is remembered under (user, key); a repeat — the network dropped the reply, or the
 * offline queue replayed — gets that same answer back, marked `Idempotent-Replayed: true`, and nothing runs again.
 *
 *  - `idempotent:required` refuses a request without a key (creates); plain `idempotent` uses a key when one is sent.
 *  - The same key with a **different** request (other path, body or company) is an error, not a silent replay.
 *  - Two requests with one key arriving together: the database's unique key lets exactly one in; the other is told to wait
 *    (409 request_in_progress, Retry-After) and, once the first finishes, gets its answer.
 *  - Only a **successful** answer is kept. Anything else (a refusal, a validation error, a crash) releases the key, so the
 *    person can fix the problem and send the same action again.
 *  - A request that started but never finished (the server died) is presumed dead after `idempotency_stale_seconds` and the
 *    key may then be taken over. Keys expire after `idempotency_ttl_hours` (`api:prune` removes them).
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:180;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Api\Http\Middleware\Idempotency";s:21:"implementingClassName";s:43:"App\Modules\Api\Http\Middleware\Idempotency";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:7:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:6:"tenant";a:13:{s:4:"name";s:6:"tenant";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:5;s:9:"endColumn";i:74;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:31:"App\Modules\Api\Http\Middleware";s:18:"declaringClassName";s:43:"App\Modules\Api\Http\Middleware\Idempotency";s:21:"implementingClassName";s:43:"App\Modules\Api\Http\Middleware\Idem