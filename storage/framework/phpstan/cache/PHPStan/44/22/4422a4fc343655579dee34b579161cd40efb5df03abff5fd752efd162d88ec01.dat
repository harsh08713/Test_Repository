O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-5d99f969c72e950719e007b50bcf4a3c976ea9a7de63dd39ce9c9518481ae581";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:50:"App\Modules\Shared\Http\Middleware\SecurityHeaders";s:8:"filename";s:85:"C:/xampp/htdocs/industrial_crm/app/Modules/Shared/Http/Middleware/SecurityHeaders.php";}}s:9:"namespace";s:34:"App\Modules\Shared\Http\Middleware";s:4:"name";s:50:"App\Modules\Shared\Http\Middleware\SecurityHeaders";s:9:"shortName";s:15:"SecurityHeaders";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:724:"/**
 * Headers that make a browser safer without changing how the application works: no content-type sniffing, no framing by other sites, a short referrer, and a permission policy that
 * leaves only what the application uses (the field-sales position check needs location; nothing needs the camera, microphone, payment or USB). HSTS is sent only on an HTTPS request in
 * production, so a local or test server is never told to insist on HTTPS. A header a response already set (a file download's own `nosniff`) is left as it is.
 *
 * There is deliberately **no Content-Security-Policy**: Livewire and Alpine evaluate expressions in the page, so a policy strict enough to matter would break them. See docs/operations.md.
