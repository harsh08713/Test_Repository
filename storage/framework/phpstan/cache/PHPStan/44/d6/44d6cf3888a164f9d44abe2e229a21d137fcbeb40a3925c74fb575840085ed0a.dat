 * One kind of spreadsheet the system can ingest. The framework (upload, template, check, queued apply, error
 * report, progress) is generic; an importer only says what its columns are and what a row means.
 *
 * Rules every importer must keep:
 *  - idempotent: loading the same file twice changes nothing the second time;
 *  - a blank cell never erases existing data;
 *  - never touches another company's data (the session runs inside the batch's company context);
 *  - the check and the apply share one code path (`ImportSession::process`), so what the preview promises is
 *    what the import does.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:16;s:7:"endLine";i:62;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:9:{s:3:"key";a:20:{s:4:"name";s:3:"key";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:73:"/** Stable key stored on the batch and used in URLs, e.g. "geography". */";s:9:"startLine";i:19;s:7:"endLine";i:19;s:11:"startColumn";i:5;s:9:"endColumn";i:34;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:26:"App\Modules\Shared\Imports";s:18:"declaringClassName";s:35:"App\Modules\Shared\Imports\Importer";s:21:"implementingClassName";s:35:"App\Modules\Shared\Imports\Importer";s:16:"currentClassName";s:35:"App\Modules\Shared\Imports\Importer";s:9:"aliasName";N;}s:5:"label";a:20:{s:4:"name";s:5:"label";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:21;s:7:"endLine";i:21;s:11:"startColumn";i:5;s:9:"endColumn";i:36;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:26:"App\Modules\Shared\Imports";s:18:"declaringClassName";s:35:"App\Modules\Shared\Imports\Importer";s:21:"implementingClassName";s:35:"App\Modules\Shared\Imports\Importer";s:16:"currentClassName";s:35:"App\Modules\Shared\Imports\Importer";s:9:"aliasName";N;}s:11:"description";a:20:{s:4:"name";s:11:"description";s:10:"parameters";a:0:{}s:16:"returnsR