 * A lead: somebody who might buy, where they came from, who is working on them and how far it has got.
 *
 * A lead belongs to a branch and to the person it is assigned to. It is numbered from the branch's own series, moves
 * through stages (LeadStage), collects follow-ups, and changes hands only through LeadTransferService, which keeps the
 * whole history. Who may see a lead is its assignee, the people who manage that person, and holders of `sales.scope_all`
 * (see LeadPolicy and SalesScope).
 *
 * A lead is either **new** (a prospect) or an **inquiry from an existing customer** (`lead_type`, see LeadType): the latter
 * points at an approved customer ledger, lists what the customer asked for with the rate they expect, and — alone of the
 * two — goes through the approval workflow. Either converts to a Deal (DealService), which takes the lead to the Deal stage.
 *
 * @property string $lead_number
 * @property LeadType $lead_type
 * @property int|null $customer_ledger_id
 * @property Carbon $lead_date
 * @property int $location_id
 * @property int $lead_source_id
 * @property string $name
 * @property string|null $contact_person
 * @property string|null $mobile
 * @property string|null $phone
 * @property string|null $email
 * @property string|null $address_line1
 * @property string|null $address_line2
 * @property string|null $city
 * @property int|null $state_id
 * @property int|null $district_id
 * @property int|null $block_id
 * @property string|null $pin_code
 * @property string|null $requirement
 * @property string|null $expected_value
 * @property int|null $assigned_to
 * @property int|null $sales_team_id
 * @property LeadStage $stage
 * @property int|null $lost_reason_id
 * @property string|null $lost_remarks
 * @property Carbon|null $lost_at
 * @property Carbon|null $next_followup_at
 * @property Carbon|null $last_contacted_at
 * @property string|null $latitude
 * @property string|null $longitude
 * @property bool $is_complete
 * @property LeadChannel $entry_channel
 * @property int|null $import_batch_id
 */";s:10:"attributes";a:2:{i:0;a:3:{s:4:"name";s:48:"Illuminate\Database\Eloquent\Attributes\Fillable";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:165:"['lead_date', 'name', 'contact_person', 'mobile', 'phone', 'email', 'address_line1', 'address_line2', 'city', 'pin_code', 'requirement', 'expected_value', 'remarks']";s:10:"attributes";a:6:{s:9:"startLine";i:77;s:7:"endLine";i:80;s:13:"startTokenPos";i:137;s:12:"startFilePos";i:3239;s:11:"endTokenPos";i:178;s:10:"endFilePos";i:3414;}}}}i:1;a:3:{s:4:"name";s:49:"Illuminate\Database\Eloquent\Attributes\UsePolicy";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:43:"\App\Modules\CRM\Policies\LeadPolicy::class";s:10:"attributes";a:6:{s:9:"startLine";i:81;s:7:"endLine";i:81;s:13:"startTokenPos";i:185;s:12:"startFilePos";i:3430;s:11:"endTokenPos";i:187;s:10:"endFilePos";i:3446;}}}}}s:9:"startLine";i:77;s:7:"endLine";i:315;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:37:"App\Modules\Shared\Models\TenantModel";s:20:"implementsClassNames";a:1:{i:0;s:47:"App\Modules\Shared\Contracts\ApprovableDocument";}s:15:"traitClassNames";a:3:{i:0;s:45:"App\Modules\Shared\Models\Concerns\Approvable";i:1;s:52:"App\Modules\Shared\Models\Concerns\BelongsToLocation";i:2;s:57:"App\Modules\Shared\Models\Concerns\ValidatesParentCompany";}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:10:"attributes";a:16:{s:18:"declaringClassName";s:27:"App\Modules\CRM\Models\Lead";s:21:"implementingClassName";s:27:"App\Modules\CRM\Models\Lead";s:4:"name";s:10:"attributes";s:9:"modifiers";i:2;s:4:"type";N;s:7:"default";a:2:{s:4:"code";s:92:"['stage' => 'new', 'lead_type' => 'new', 'is_complete' => true, 'entry_channel' => 'manual']";s:10:"attributes";a:6:{s:9:"startLine";i:87;s:7:"endLine";i:92;s:13:"startTokenPos";i:224;s:12:"startFilePos";i:3688;s:11:"endTokenPos";i:254;s:10:"endFilePos";i:3818;}}s:10:"docComment";s:78:"/** A lead has no active/inactive `status`: its stage says wher