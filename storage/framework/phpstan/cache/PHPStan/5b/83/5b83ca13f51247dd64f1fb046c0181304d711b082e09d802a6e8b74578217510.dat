O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-cd977e42377ceec07720d5c4452f2139ecf92dd6e316666a88b0f35b7c341464";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Inventory\Services\StockService";s:8:"filename";s:78:"C:/xampp/htdocs/industrial_crm/app/Modules/Inventory/Services/StockService.php";}}s:9:"namespace";s:30:"App\Modules\Inventory\Services";s:4:"name";s:43:"App\Modules\Inventory\Services\StockService";s:9:"shortName";s:12:"StockService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1418:"/**
 * The one door for stock: every change of quantity is a row of the stock ledger (StockMovement), and the balance it leaves is kept in step in
 * the same transaction. Nothing else writes either table.
 *
 *  - Quantities are in the item's **base unit**; callers convert (UomConverter) before they come here.
 *  - **Moving average.** Each balance row (branch × item × batch) is its own pool: a receipt adds quantity and value, an issue / scrap /
 *    adjustment-out / transfer-out takes value out at that pool's average, and when the last unit leaves the whole remaining value leaves with
 *    it, so no rounding residue is left behind. A transfer arrives at exactly the value that left.
 *  - **No negative stock**: asking for more than is on hand is refused (and the database holds a CHECK as the backstop).
 *  - **Tracking.** An item tracked by batch needs a batch on every movement; one that is not must have none. A batch that has expired, or is in
 *    quarantine, cannot be issued or transferred — it can be scrapped.
 *  - **Once per document line.** A movement that names its source (`receive()` from a goods receipt) is made once: asking again returns the first
 *    one, and `unique(company, source type, source id, line, movement type)` is the backstop.
 *  - A person's own entries are checked against the branches they work in; a document posting (no person) is checked by the document.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:316;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:8:"ATTEMPTS";a:12:{s:18:"declaringClassName";s:43:"App\Modules\Inventory\Services\StockService";s:21:"implementingClassName";s:43:"App\Modules\Inventory\Services\StockService";s:4:"name";s:8:"ATTEMPTS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"3";s:10:"attributes";a:6:{s:9:"startLine";i:34;s:7:"endLine";i:34;s:13:"startTokenPos";i:77;s:12:"startFilePos";i:2083;s:11:"endTokenPos";i:77;s:10:"endFilePos";i:2083;}}s:10:"docComment";s:120:"/** A deadlock is retried this many times when the movement is the outermost transaction (a nested one cannot retry). */";s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:34;s:11:"startColumn";i:5;s:9:"endColumn";i:31;}}s:19:"immediateProperties";a:1:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Inventory\Services\StockService";s:21:"implementingClassName";s:43:"App\Modules\Inventory\Services\StockService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:36;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:18:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:6:"tenant";a:13:{s:4:"name";s:6:"tenant";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:10:"is