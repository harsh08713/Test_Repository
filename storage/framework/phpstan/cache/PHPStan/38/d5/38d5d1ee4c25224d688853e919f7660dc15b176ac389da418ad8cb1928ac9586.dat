 * Runs an offline app's queue of changes, in order, **through the real endpoints**.
 *
 * Each operation becomes an ordinary request to the route it names — same token, same company, its own `Idempotency-Key` — and is dispatched through the
 * router, so every rule of the real call applies unchanged: the device's scope, the throttle, the idempotency key, validation, the policies, the
 * geofence, the approval rules. Nothing about a queued change is trusted more because it was queued; this class owns no business rule, it only carries
 * requests and describes how each one ended (`SyncOutcome`).
 *
 *  - Only a change that is safe to replay can be queued: a POST, PATCH or DELETE on a `/api/v1` route that honours an Idempotency-Key. Signing in or out, reads
 *    and `/sync` itself are not.
 *  - An operation may name a record made earlier in the same queue: `@lead-1` in a path becomes the id the operation with `ref: "lead-1"` was given. If that
 *    operation did not go through, the one that needs it is skipped — never sent with a guess.
 *  - Operations that do not depend on each other do not hold each other up: a rejected or conflicting change does not stop the rest. A refused device or
 *    account, an expired token or a throttle does (everything after it is `skipped`), because trying again now cannot go better.
 *
 * @phpstan-type Operation array{id: string, method: string, path: string, body: array<string, mixed>|null, ref: string|null}
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:185;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:14:"MAX_OPERATIONS";a:12:{s:18:"declaringClassName";s:35:"App\Modules\Api\Services\SyncRunner";s:21:"implementingClassName";s:35:"App\Modules\Api\Services\SyncRunner";s:4:"name";s:14:"MAX_OPERATIONS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"25";s:10:"attributes";a:6:{s:9:"startLine";i:30;s:7:"endLine";i:30;s:13:"startTokenPos";i:50;s:12:"startFilePos";i:1757;s:11:"endTokenPos";i:50;s:10:"endFilePos";i:1758;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:30;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}}s:19:"immediateProperties";a:1:{s:6:"router";a:16:{s:18:"declaringClassName";s:35:"App\Modules\Api\Services\SyncRunner";s:21:"implementingClassName";s:35:"App\Modules\Api\Services\SyncRunner";s:4:"name";s:6:"router";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:25:"Illuminate\Routing\Router";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:33;s:9:"endColumn";i:63;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:7:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:6:"router";a:13:{s:4:"name";s:6:"router";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:25:"Illuminate\Routing\Router";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:33;s:9:"endColumn";i:63;s:14:"paramete