O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-fa3e4cc023cb31cef0f70ff0a1f481d0030971d1e079a97dd4521204d46a3c77";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Sales\Services\InvoiceGenerator";s:8:"filename";s:78:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/InvoiceGenerator.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:43:"App\Modules\Sales\Services\InvoiceGenerator";s:9:"shortName";s:16:"InvoiceGenerator";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1541:"/**
 * Makes the sales invoice for an approved sales order — **exactly one, however many times it is asked for**.
 *
 * Under this release's full-invoice policy an approved order gets one invoice for all of its lines, keyed `full`. It is asked for when the
 * order is approved (the DocumentApproved listener), when the retry command finds an approved order without one, and by anyone who calls
 * `generateFor()` again; every one of those is safe:
 *
 *  1. An invoice that already exists is returned at once, without taking a number.
 *  2. Otherwise, inside a transaction: the invoice number is taken **first** (so concurrent callers queue on the series instead of
 *     deadlocking), the order's row is locked, and the existence of the invoice is checked again with a locking read. If it has appeared in
 *     the meantime the transaction is rolled back — which also gives the number back, so the series stays free of gaps — and that invoice is
 *     returned.
 *  3. `unique(sales_order_id, source_key)` is the backstop: even if every one of the above failed, a second invoice cannot be inserted.
 *
 * The invoice is a copy of the order as it was approved — customer, addresses, place of supply, prices, tax, totals — with its own number and
 * links to the order and to each of its lines. It posts nothing to stock or to accounts. A failure that is not a duplicate leaves the order
 * approved and without an invoice, records what went wrong on the order (`invoice_error`) and is retried by `sales:generate-invoices`.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:187;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:7:"numbers";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Sales\Services\InvoiceGenerator";s:21:"implementingClassName";s:43:"App\Modules\Sales\Services\InvoiceGenerator";s:4:"name";s:7:"numbers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:33;s:9:"endColumn";i:77;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"costs";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Sales\Services\InvoiceGenerator";s:21:"implementingClassName";s:43:"App\Modules\Sales\Services\InvoiceGenerator";s:4:"name";s:5:"costs";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\Masters\Services\CostResolver";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:80;s:9:"endColumn";i:115;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:6:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:7:"numbers";a:13:{s:4:"name";s:7:"numbers";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Shared\Services\NumberSeriesService";s:12:"isIdentifier";b:0;}}s:10:"isVariadic