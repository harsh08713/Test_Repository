O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-60f760a548a99d72f6f7d861fb73904fede9685b814d44ba89ae237981ae3dcd";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:39:"App\Modules\CRM\Services\DealForecaster";s:8:"filename";s:74:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/DealForecaster.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:39:"App\Modules\CRM\Services\DealForecaster";s:9:"shortName";s:14:"DealForecaster";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1139:"/**
 * An advisory chance of winning an open deal, from the company's own history (brief 6.2: "forecast deal probability only as an advisory estimate"). **No AI**: it counts.
 *
 * For each open stage — Discovery, Negotiation, Quotation — it looks at the company's *closed* deals (won or lost) that ever reached that stage, and how many of them were won:
 *
 *     chance = (won + weight × usual) ÷ (deals + weight)
 *
 * where *usual* is the stage's usual chance (the probability a deal starts with there) and *weight* is how many deals' worth of belief that usual figure is given (Company settings →
 * Deal forecast, default 10). With no history the estimate **is** the usual figure; each closed deal moves it towards what really happened, so a few lucky deals cannot swing it. It is kept
 * between 1 and 99 per cent, like a deal's own probability. `confidence` says how many deals it rests on (thin below the "fair" count, good from the "good" count) — the page shows it.
 *
 * It is advice: it reads, it never writes. The deal's own probability, the pipeline totals and the dashboards still use the figure a person set.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:102;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:4:"OPEN";a:12:{s:18:"declaringClassName";s:39:"App\Modules\CRM\Services\DealForecaster";s:21:"implementingClassName";s:39:"App\Modules\CRM\Services\DealForecaster";s:4:"name";s:4:"OPEN";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:137:"[\App\Modules\CRM\Enums\DealStage::Discovery, \App\Modules\CRM\Enums\DealStage::Negotiation, \App\Modules\CRM\Enums\DealStage::Quotation]";s:10:"attributes";a:6:{s:9:"startLine";i:27;s:7:"endLine";i:27;s:13:"startTokenPos";i:52;s:12:"startFilePos";i:1498;s:11:"endTokenPos";i:66;s:10:"endFilePos";i:1565;}}s:10:"docComment";s:58:"/** The stages a deal can be in while it is still open. */";s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:5;s:9:"endColumn";i:94;}}s:19:"immediateProperties";a:1:{s:8:"settings";a:16:{s:18:"declaringClassName";s:39:"App\Modules\CRM\Services\DealForecaster";s:21:"implementingClassName";s:39:"App\Modules\CRM\Services\DealForecaster";s:4:"name";s:8:"settings";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Services\SettingsService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:29;s:11:"startColumn";i:33;s:9:"endColumn";i:74;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:5:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:8:"settings";a:13:{s:4:"name";s:8:"settings";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Sha