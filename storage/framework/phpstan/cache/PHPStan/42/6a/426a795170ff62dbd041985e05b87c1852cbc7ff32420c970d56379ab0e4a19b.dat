 * @property Carbon|null $cancelled_at
 * @property string|null $cancel_reason
 */";s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:49:"Illuminate\Database\Eloquent\Attributes\UsePolicy";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:53:"\App\Modules\Sales\Policies\SalesInvoicePolicy::class";s:10:"attributes";a:6:{s:9:"startLine";i:70;s:7:"endLine";i:70;s:13:"startTokenPos";i:77;s:12:"startFilePos";i:2887;s:11:"endTokenPos";i:79;s:10:"endFilePos";i:2911;}}}}}s:9:"startLine";i:70;s:7:"endLine";i:204;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:37:"App\Modules\Shared\Models\TenantModel";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:2:{i:0;s:52:"App\Modules\Shared\Models\Concerns\BelongsToLocation";i:1;s:57:"App\Modules\Shared\Models\Concerns\ValidatesParentCompany";}s:18:"immediateConstants";a:4:{s:4:"FULL";a:12:{s:18:"declaringClassName";s:37:"App\Modules\Sales\Models\SalesInvoice";s:21:"implementingClassName";s:37:"App\Modules\Sales\Models\SalesInvoice";s:4:"name";s:4:"FULL";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:6:"'full'";s:10:"attributes";a:6:{s:9:"startLine";i:76;s:7:"endLine";i:76;s:13:"startTokenPos";i:111;s:12:"startFilePos";i:3130;s:11:"endTokenPos";i:111;s:10:"endFilePos";i:3135;}}s:10:"docComment";s:93:"/** The key of the invoice that covers the whole order (the only kind this release makes). */";s:10:"attributes";a:0:{}s:9:"startLine";i:76;s:7:"endLine";i:76;s:11:"startColumn";i:5;s:9:"endColumn";i:31;}s:6:"ISSUED";a:12:{s:18:"declaringClassName";s:37:"App\Modules\Sales\Models\SalesInvoice";s:21:"implementingClassName";s:37:"App\Modules\Sales\Models\SalesInvoice";s:4:"name";s:6:"ISSUED";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:8:"'issued'";s:10:"attributes";a:6:{s:9:"startLine";i:78;s:7:"endLine";i:78;s:13:"startTokenPos";i:122;s:12:"startFilePos";i:3165;s:11:"endTokenPos";i:122;s:10:"endFilePos";i:3172;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:78;s:7:"endLine";i:78;s:11:"startColumn";i:5;s:9:"endColumn";i:35;}s:9:"