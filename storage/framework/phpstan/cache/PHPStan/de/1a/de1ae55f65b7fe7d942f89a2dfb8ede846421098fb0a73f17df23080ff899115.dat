O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-a95e6ba9c6db2327a1db9aa70ce385f0c3078d3b7380bdc5dbfd24cfde615ab9";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Api\Http\Controllers\DealController";s:8:"filename";s:82:"C:/xampp/htdocs/industrial_crm/app/Modules/Api/Http/Controllers/DealController.php";}}s:9:"namespace";s:32:"App\Modules\Api\Http\Controllers";s:4:"name";s:47:"App\Modules\Api\Http\Controllers\DealController";s:9:"shortName";s:14:"DealController";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1034:"/**
 * Deals over the API: the same rules as the screens, because every write goes through DealService (and approval through
 * ApprovalService).
 *
 *  - **What a person sees** is DealAccess (their own, their team's, everyone's for `sales.scope_all`, and the deals an approver is
 *    asked about). Anything else is a 404.
 *  - **Making a deal** is converting a qualified lead: `POST /leads/{lead}/convert`. The lead's own lines must all come across,
 *    each with the rate expected; the number, the amounts, the value, the branch and the owner are the server's.
 *  - **Changing a deal.** The customer and the lines change only while the deal is a draft or was returned; where it stands (close
 *    date, probability, remarks) while it is open. What the state forbids is a 409 with the reason, not a bare 403.
 *  - **Sync.** `updated_since` returns everything changed at or after that moment, in change order; `meta.server_time` is the
 *    value to send next time. (A deal is never deleted, so there is nothing to drop.)
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:37;s:7:"endLine";i:202;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:46:"App\Modules\Api\Http\Controllers\ApiController";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:4:"WITH";a:12:{s:18:"declaringClassName";s:47:"App\Modules\Api\Http\Controllers\DealController";s:21:"implementingClassName";s:47:"App\Modules\Api\Http\Controllers\DealController";s:4:"name";s:4:"WITH";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:115:"['assignee:id,name', 'location:id,code,name', 'customer:id,code,name', 'lead:id,lead_number', 'lostReason:id,name']";s:10:"attributes";a:6:{s:9:"startLine";i:39;s:7:"endLine";i:39;s:13:"startTokenPos";i:117;s:12:"startFilePos";i:1914;s:11:"endTokenPos";i:131;s:10:"endFilePos";i:2028;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:39;s:11:"startColumn";i:5;s:9:"endColumn";i:141;}s:6:"DETAIL";a:12:{s:18:"declaringClassName";s:47:"App\Modules\Api\Http\Controllers\DealController";s:21:"implementingClassName";s:47:"App\Modules\Api\Http\Controllers\DealController";s:4:"name";s:6:"DETAIL";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:129:"[...self::WITH, 'items.item:id,code,name', 'items.unit:id,code', 'stageHistory.actor:id,name', 'stageHistory.lostReason:id,name']";s:10:"attributes";a:6:{s:9:"startLine";i:41;s:7:"endLine";i:41;s:13:"startTokenPos";i:142;s:12:"startFilePos";i:2059;s:11:"endTokenPos";i:159;s:10:"endFilePos";i:2187;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:41;s:7:"endLine";i:41;s:11:"startColumn";i:5;s:9:"endColumn";i:157;}}s:19:"immediateProperties";a:2:{s:5:"deals";a:16:{s:18:"declaringClassName";s:47:"App\Modules\Api\Http\Controllers\DealController";s:21:"implementingClassName";s:47:"App\Modules\Api\Http\Controllers\DealController";s:4:"name";s:5:"deals";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Re