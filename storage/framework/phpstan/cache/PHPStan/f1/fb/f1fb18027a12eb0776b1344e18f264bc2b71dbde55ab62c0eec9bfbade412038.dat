 * The money of a loss incident: the one place impact is worked out (FORMULAS.md §4) and the one door for impact lines.
 *
 *  - Each formula has a key, a version and named inputs; a line keeps all three, so a figure can always be traced and redone. bcmath throughout;
 *    the amount is rounded once, half up to paise. A result below zero is refused (the inputs are wrong), never stored as a negative loss.
 *  - **Kinds stay apart**: a line is actual loss, estimated exposure or recoverable opportunity. An opportunity must say its assumptions, its
 *    confidence and its target period; a manual figure must say its assumptions.
 *  - **Recalculation never edits**: the old line is marked superseded (and points at its replacement), a new line is added — audited with both
 *    amounts. Only current (not superseded) lines count.
 *  - **Validation is maker–checker**: someone holding `loss_incident.approve` who did not enter the line validates or rejects it. Only validated
 *    actual lines are "actual loss".
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:329;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:7:"VERSION";a:12:{s:18:"declaringClassName";s:48:"App\Modules\Loss\Services\LossCalculationService";s:21:"implementingClassName";s:48:"App\Modules\Loss\Services\LossCalculationService";s:4:"name";s:7:"VERSION";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"1";s:10:"attributes";a:6:{s:9:"startLine";i:26;s:7:"endLine";i:26;s:13:"startTokenPos";i:55;s:12:"startFilePos";i:1369;s:11:"endTokenPos";i:55;s:10:"endFilePos";i:1369;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:26;s:11:"startColumn";i:5;s:9:"endColumn";i:29;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:11:{s:8:"formulas";a:20:{s:4:"name";s:8:"formulas";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:258:"/**
