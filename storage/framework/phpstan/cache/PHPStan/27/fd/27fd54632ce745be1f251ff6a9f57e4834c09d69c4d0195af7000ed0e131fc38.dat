 * The shared approval engine.
 *
 *  - Levels come from `approval_levels` (per company + document type). With none configured the document has
 *    one implicit level: the role the document type routes to by default (`defaultApproverRole()`, e.g. items →
 *    Accounts), or — when it names none — anyone holding `{form}.approve`.
 *  - Levels are decided in order (default) or all at once, per company + document type (ApprovalMode).
 *    A rejection at any level rejects the document and cancels the levels still waiting.
 *  - Every submission creates a new `cycle` of rows, so history survives resubmission.
 *  - The document is fingerprinted at submission; if it changed afterwards it cannot be approved — it has to
 *    be rejected (returning it to its owner) and resubmitted.
 *  - Nobody has an implicit bypass. Deciding a level you were not designated for needs the explicit
 *    `approval.override` permission, and is recorded on the row and in the audit log as an override.
 *  - Everything runs in a transaction with the document row locked, so two approvers cannot decide the
 *    same level twice. Events fire only after the transaction commits.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:41;s:7:"endLine";i:520;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Shared\Services\ApprovalService";s:21:"implementingClassName";s:43:"App\Modules\Shared\Services\ApprovalService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:44;s:7:"endLine";i:44;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"settings";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Shared\Services\ApprovalService";s:21:"implementingClassName";s:43:"App\Modules\Shared\Services\ApprovalService";s:4:"name";s:8:"settings";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Services\SettingsService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:9;s:9:"endColumn";i:50;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:22:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:6:"tenant";a:13:{s:4:"name";s:6:"tenant";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"b