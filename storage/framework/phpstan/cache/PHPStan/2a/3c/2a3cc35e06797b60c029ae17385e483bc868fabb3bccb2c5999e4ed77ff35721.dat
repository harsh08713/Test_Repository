O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-d3cdbd19fedfd2e9e030eddb821be0721892560e8f4fb7354692af1b14be76a0";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Loss\Services\SavingsService";s:8:"filename";s:75:"C:/xampp/htdocs/industrial_crm/app/Modules/Loss/Services/SavingsService.php";}}s:9:"namespace";s:25:"App\Modules\Loss\Services";s:4:"name";s:40:"App\Modules\Loss\Services\SavingsService";s:9:"shortName";s:14:"SavingsService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1677:"/**
 * The Verified Savings Ledger — the one door for savings measurements (docs/savings.md).
 *
 *  - **Start** (`start`): only on a corrective action someone else has already verified, once (`unique(corrective_action_id)` + the action's row lock).
 *    The draft gets sensible dates (30 days before the action was done; from the day it was done until today) which the person changes.
 *  - **Work it out** (`calculate`, shared by the form's preview and the save): the actual validated loss of the incident's category at its branch (and
 *    item) in the baseline period and in the measurement window — read from `LossFigures`, never typed — the baseline scaled by volume (both volumes
 *    entered) or else by days, and the saving = scaled baseline − loss in the window − what the action cost. It can be negative.
 *  - **Submit** (`submit`): windows of at least `MIN_WINDOW_DAYS`, ended, after the action was done, evidence written, and **no other live measurement
 *    of the same category and branch (and item) whose window overlaps** — the same loss cannot be claimed twice. The figures are worked out again and
 *    kept as the evidence the approver sees; from then on nothing changes.
 *  - **Decide** (`approve` / `reject`): by `savings_measurement.approve`, never the person who measured it or the action's owner. A rejected one goes
 *    back to draft with `reopen`.
 *  - **Recurrence** (`sweepRecurrence`, daily): a verified measurement whose category recurs at the same branch after its window is flagged once.
 *
 * A finance-verified saving is a different figure from the corrective action's own "verified result" and is never added to it.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:435;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:15:"MIN_WINDOW_DAYS";a:12:{s:18:"declaringClassName";s:40:"App\Modules\Loss\Services\SavingsService";s:21:"implementingClassName";s:40:"App\Modules\Loss\Services\SavingsService";s:4:"name";s:15:"MIN_WINDOW_DAYS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"7";s:10:"attributes";a:6:{s:9:"startLine";i:40;s:7:"endLine";i:40;s:13:"startTokenPos";i:100;s:12:"startFilePos";i:2370;s:11:"endTokenPos";i:100;s:10:"endFilePos";i:2370;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:40;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}}s:19:"immediateProperties";a:3:{s:7:"figures";a:16:{s:18:"declaringClassName";s:40:"App\Modules\Loss\Services\SavingsService";s:21:"implementingClassName";s:40:"App\Modules\Loss\Services\SavingsService";s:4:"name";s:7:"figures";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:37:"App\Modules\Loss\Services\LossFigures";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:42;s:7:"endLine";i:42;s:11:"startColumn";i:33;s:9:"endColumn";i:69;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:6:"tenant";a:16:{s:18:"declaringClassName";s:40:"App\Modules\Loss\Services\SavingsService";s:21:"implementingClassName";s:40:"App\Modules\Loss\Services\SavingsService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:42;s