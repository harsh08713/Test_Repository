 * Creates teams and moves people on and off them. The single gate for team data; it does not decide who may (the
 * policies do) but it does keep the structure honest:
 *
 *  - a team's manager is an active user of the company, and unless the person saving can see everyone they can only
 *    run teams of which they are the manager;
 *  - a person is on **one team at a time**, and their memberships never overlap in time — the database backs this with
 *    a generated column, so two simultaneous requests cannot both add the same person;
 *  - leaving a team ends the membership (`left_on`, the last day, inclusive); nothing is deleted, so a past month's
 *    team can still be reconstructed.
 *
 * Input for saveTeam: ['team' => [code, name, manager_user_id, status, remarks]].
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:244;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:41:"App\Modules\CRM\Services\SalesTeamService";s:21:"implementingClassName";s:41:"App\Modules\CRM\Services\SalesTeamService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"scope";a:16:{s:18:"declaringClassName";s:41:"App\Modules\CRM\Services\SalesTeamService";s:21:"implementingClassName";s:41:"App\Modules\CRM\Services\SalesTeamService";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:73;s:9:"endColumn";i:106;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:8:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:6:"tenant";a:13:{s:4:"name";s:6:"tenant";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPr