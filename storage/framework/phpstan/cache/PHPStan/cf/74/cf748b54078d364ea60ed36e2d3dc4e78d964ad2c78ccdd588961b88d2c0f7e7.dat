O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-5c8c6872cb1b7276511233ce20fe3fe498670c026d605543b4bc8615369af25e";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Imports\CommitsInBatches";s:8:"filename";s:78:"C:/xampp/htdocs/industrial_crm/app/Modules/Shared/Imports/CommitsInBatches.php";}}s:9:"namespace";s:26:"App\Modules\Shared\Imports";s:4:"name";s:43:"App\Modules\Shared\Imports\CommitsInBatches";s:9:"shortName";s:16:"CommitsInBatches";s:11:"isInterface";b:1;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:694:"/**
 * For an importer whose rows should be committed a few at a time rather than a whole chunk (thousands of rows) at once.
 *
 * A chunk's transaction holds every lock its rows take until it commits. That is right for a bulk load of reference data,
 * and wrong for rows that take a lock other people's work waits on: importing a lead takes its branch's number series,
 * and at some tens of milliseconds a lead, a chunk of 2,000 would keep anyone typing a lead into that branch waiting for
 * the best part of a minute — longer than the database is willing to wait.
 *
 * Reading the file is not affected (it is still read a chunk at a time); only how many rows share a transaction is.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:15;s:7:"endLine";i:19;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:11:"commitEvery";a:20:{s:4:"name";s:11:"commitEvery";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:101:"/** How many rows are committed together. Small enough that the locks are held for a second or so. */";s:9:"startLine";i:18;s:7:"endLine";i:18;s:11:"startColumn";i:5;s:9:"endColumn";i:39;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:26:"App\Modules\Shared\Imports";s:18:"declaringClassName";s:43:"App\Modules\Shared\Imports\CommitsInBatches";s:21:"implementingClassName";s:43:"App\Modules\Shared\Imports\CommitsInBatches";s:16:"currentClassName";s:43:"App\Modules\Shared\Imports\CommitsInBatches";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}