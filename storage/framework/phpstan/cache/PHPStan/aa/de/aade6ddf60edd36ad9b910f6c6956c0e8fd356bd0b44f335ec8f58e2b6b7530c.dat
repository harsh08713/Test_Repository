 * "Is this person, standing where their device says, allowed to do this field action now?" — the one answer attendance and
 * a lead saved from the field both need, so the two cannot drift apart.
 *
 * In order, and the first failure refuses the attempt, writes it to the violation log (with what it was for) and says why:
 *
 *  1. the person has a **published** route plan for today — none, a draft or a cancelled one all mean "no route plan";
 *  2. the reported position is a real one, accurate enough and inside the geofence of a stop of that plan (GeofenceService).
 *
 * Nothing the device computed is trusted: it sends a position and an accuracy; the plan, the day, the distance, the radius
 * and the verdict are the server's. It decides and logs; what the action then does (record attendance, save a lead) is the
 * caller's business.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:123;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:10:"ATTENDANCE";a:12:{s:18:"declaringClassName";s:42:"App\Modules\CRM\Services\FieldPositionGate";s:21:"implementingClassName";s:42:"App\Modules\CRM\Services\FieldPositionGate";s:4:"name";s:10:"ATTENDANCE";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:12:"'attendance'";s:10:"attributes";a:6:{s:9:"startLine";i:32;s:7:"endLine";i:32;s:13:"startTokenPos";i:80;s:12:"startFilePos";i:1403;s:11:"endTokenPos";i:80;s:10:"endFilePos";i:1414;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:5;s:9:"endColumn";i:43;}s:9:"LEAD_SAVE";a:12:{s:18:"declaringClassName";s:42:"App\Modules\CRM\Services\FieldPositionGate";s:21:"implementingClassName";s:42:"App\Modules\CRM\Services\FieldPositionGate";s:4:"name";s:9:"LEAD_SAVE";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:11:"'lead_save'";s:10:"attributes";a:6:{s:9:"startLine";i:34;s:7:"endLine";i:34;s:13:"startTokenPos";i:91;s:12:"startFilePos";i:1447;s:11:"endTokenPos";i:91;s:10:"endFilePos";i:1457;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:34;s:11:"startColumn";i:5;s:9:"endColumn";i:41;}}s:19:"immediateProperties";a:2:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:42:"App\Modules\CRM\Services\FieldPositionGate";s:21:"implementingClassName";s:42:"App\Modules\CRM\Services\FieldPositionGate";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:37;s:7:"endLine";i:37;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromot