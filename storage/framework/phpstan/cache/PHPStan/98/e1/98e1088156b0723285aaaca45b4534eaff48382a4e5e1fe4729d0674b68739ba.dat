O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-f7baccf111e93f458dc3166e4fb47f6c9facdaf40d78fbeb015ed9bf78950b22";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:46:"App\Modules\Integrations\Services\ProviderSync";s:8:"filename";s:81:"C:/xampp/htdocs/industrial_crm/app/Modules/Integrations/Services/ProviderSync.php";}}s:9:"namespace";s:33:"App\Modules\Integrations\Services";s:4:"name";s:46:"App\Modules\Integrations\Services\ProviderSync";s:9:"shortName";s:12:"ProviderSync";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1118:"/**
 * Fetches leads from a provider that has a pull API, within the provider's rules, and hands each one to the log.
 *
 *  - **A watermark.** `cursor_at` is the end of the last period fetched in full; the next call starts a little *before* it
 *    (an overlap, so a lead the provider published late is not missed) and the duplicates that causes cost nothing: the log is
 *    unique per provider lead id. The cursor moves only after every record of the period has been written down.
 *  - **The provider's limits.** Never two calls closer than its minimum gap (claimed with one conditional UPDATE, so two workers
 *    cannot both go), never a period longer than it serves, never a request it has told us it will not take: a wrong or expired
 *    key waits for a person; "too often" waits the time it asked for; trouble on its side backs off, 15 minutes doubling to four hours.
 *  - **Nothing secret in what is stored.** The error kept on the connection is scrubbed of the key, which is in the address of
 *    the call.
 *
 * It decides nothing about leads — that is LeadIntake's, for every provider alike.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:177;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:15:"OVERLAP_MINUTES";a:12:{s:18:"declaringClassName";s:46:"App\Modules\Integrations\Services\ProviderSync";s:21:"implementingClassName";s:46:"App\Modules\Integrations\Services\ProviderSync";s:4:"name";s:15:"OVERLAP_MINUTES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"10";s:10:"attributes";a:6:{s:9:"startLine";i:32;s:7:"endLine";i:32;s:13:"startTokenPos";i:72;s:12:"startFilePos";i:1765;s:11:"endTokenPos";i:72;s:10:"endFilePos";i:1766;}}s:10:"docComment";s:102:"/** Each pull starts this far before the last one ended, to catch what the provider published late. */";s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:5;s:9:"endColumn";i:38;}}s:19:"immediateProperties";a:3:{s:9:"providers";a:16:{s:18:"declaringClassName";s:46:"App\Modules\Integrations\Services\ProviderSync";s:21:"implementingClassName";s:46:"App\Modules\Integrations\Services\ProviderSync";s:4:"name";s:9:"providers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:51:"App\Modules\Integrations\Providers\ProviderRegistry";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:9;s:9:"endColumn";i:52;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"settings";a:16:{s:18:"declaringClassName";s:46:"App\Modules\Integrations\Services\ProviderSync";s:21:"implementingClassName";s:46:"App\Modules\Integrations\Services\ProviderSync";s:4:"name";s:8:"settings";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s: