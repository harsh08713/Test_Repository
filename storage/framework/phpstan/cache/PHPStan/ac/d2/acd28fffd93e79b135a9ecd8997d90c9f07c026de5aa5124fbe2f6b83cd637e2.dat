 * Gives a company the reference data every company needs: the 36 states/UTs with GST codes, the standard
 * units of measure, the standard Indian chart-of-accounts groups, the usual payment methods, and the CRM's lead
 * sources, follow-up outcomes and lost reasons (SeedCrmDefaults).
 *
 * Idempotent: running it again only adds what is missing and never touches rows an administrator has since
 * edited (a row an administrator deleted counts as present, so it is not brought back). It is a system action
 * (it runs without a user's tenant restrictions) that writes straight to the tables in one transaction — about a
 * hundred rows in a handful of statements — and records one summary audit entry instead of a "created" entry for
 * each seeded row.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:196;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:47:"App\Modules\Masters\Actions\SeedCompanyDefaults";s:21:"implementingClassName";s:47:"App\Modules\Masters\Actions\SeedCompanyDefaults";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:24;s:11:"startColumn";i:33;s:9:"endColumn";i:70;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:3:"crm";a:16:{s:18:"declaringClassName";s:47:"App\Modules\Masters\Actions\SeedCompanyDefaults";s:21:"implementingClassName";s:47:"App\Modules\Masters\Actions\SeedCompanyDefaults";s:4:"name";s:3:"crm";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:39:"App\Modules\CRM\Actions\SeedCrmDefaults";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:24;s:11:"startColumn";i:73;s:9:"endColumn";i:109;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:9:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:6:"tenant";a:13:{s:4:"name";s:6:"tenant";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s: