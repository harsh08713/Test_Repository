O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-fa619c3dbe1ca507dc98c675d0202864a03abb2e902e37dab5d4244942320b6d";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:36:"App\Modules\CRM\Services\LeadService";s:8:"filename";s:71:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/LeadService.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:36:"App\Modules\CRM\Services\LeadService";s:9:"shortName";s:11:"LeadService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:2741:"/**
 * Creates and changes leads. The single gate for lead data — the form, the spreadsheet import and (later) the mobile API
 * and the marketplace integrations all come through here — so the rules are the same whichever way a lead arrives.
 * It does not decide who may (LeadPolicy does). A lead saved from the field goes through FieldLeadService first, which
 * checks the position against today's route plan and only then comes here.
 *
 *  - A lead belongs to a branch the person can use, and is numbered from that branch's series in the same transaction
 *    that saves it. The branch never changes afterwards.
 *  - The mobile number is stored as its ten digits. **Duplicates are warned about, not blocked**: if an *open* lead in the
 *    company (any branch) already has the number, the save is refused until the person says "this is a separate inquiry".
 *  - A PIN code that is in the geography master fills the state, district and block where the answer is unambiguous, and
 *    is refused if it contradicts a district or state that was chosen.
 *  - Someone who may not hand out leads (`lead.assign`) always becomes the owner of what they enter; someone who may can
 *    give it to themselves, to a person they manage, or leave it unassigned. After that, a lead changes hands only
 *    through LeadTransferService.
 *  - Stages move by LeadStage's rules; "lost" needs a reason, re-opening needs a comment, and Deal / Quotation / Won are
 *    never set by hand (DealService sets them, through setStageBySystem()). Every move is written to the stage history.
 *  - **An inquiry from an existing customer** is a lead that names a customer (`lead.customer_ledger_id`): an approved,
 *    active customer ledger of the company, taken once when the inquiry is entered and never changed after. The customer's
 *    name, contact, mobile, e-mail and billing address are copied onto the lead as they are then (nothing typed for them is
 *    used), so the lead reads like any other. Such a customer may ask again and again, so there is no duplicate warning and
 *    no mobile number is needed; every line must name an approved item, and may carry the rate the customer expects. The
 *    expected value is the sum of the priced lines, worked out here. Once it is in approval or approved it is locked.
 *
 * Input: ['lead' => [location_id, lead_date, lead_source_id, customer_ledger_id, name, contact_person, mobile, phone, email,
 *                    address_line1, address_line2, city, state_id, district_id, block_id, pin_code, requirement,
 *                    expected_value, assigned_to, remarks, acknowledge_duplicate],
 *         'interests' => [[id?, item_id, description, quantity, unit_id, expected_rate], …]]
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:73;s:7:"endLine";i:907;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:13:"MAX_INTERESTS";a:12:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\LeadService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\LeadService";s:4:"name";s:13:"MAX_INTERESTS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"30";s:10:"attributes";a:6:{s:9:"startLine";i:75;s:7:"endLine";i:75;s:13:"startTokenPos";i:215;s:12:"startFilePos";i:4423;s:11:"endTokenPos";i:215;s:10:"endFilePos";i:4424;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:75;s:7:"endLine";i:75;s:11:"startColumn";i:5;s:9:"endColumn";i:36;}s:17:"DEADLOCK_ATTEMPTS";a:12:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\LeadService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\LeadService";s:4:"name";s:17:"DEADLOCK_ATTEMPTS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"3";s:10:"attributes";a:6:{s:9:"startLine";i:82;s:7:"endLine";i:82;s:13:"startTokenPos";i:228;s:12:"startFilePos";i:4832;s:11:"endTokenPos";i:228;s:10:"endFilePos";i:4832;}}s:10:"docComment";s:345:"/**
 * Entering a lead takes the branch's number-series lock first and nothing before it, so two entries queue rather
 * than deadlock. Should the database still choose one as a deadlock victim, entering it again is safe: nothing of
 * the failed attempt was kept, not even its number. (Only possible when this is the outermost transaction.)
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:82;s:7:"endLine";i:82;s:11:"startColumn";i:5;s:9:"endColumn";i:40;}}s:19:"immediateProperties";a:8:{s:6:"tenant";a:16:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\LeadService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\LeadService";s:4:"name";s:6:"tenant";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Modules\Shared\Tenancy\TenantContext";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:85;s:7:"endLine";i:85;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"scope";a:16:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\LeadService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\LeadService";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:86;s:7:"endLine";i:86;s:11:"startColumn";i:9;s:9:"endColumn";i:42;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"teams";a:16:{s:18:"declaringClassName";s:36:"App\Modules\CRM\Services\LeadService";s:21:"implementingClassName";s:36:"App\Modules\CRM\Services\LeadService";s:4:"name";s:5:"teams";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\CRM\Services\SalesTeamService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:87;s:7:"endLine";i:87;s:11:"startColumn";i:9;s:9:"endColumn";i:48;s:10: