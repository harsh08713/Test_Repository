 * One lead a provider handed over, kept exactly as received (minus anything secret) together with what became of it.
 *
 * It is written **before** anything else happens to the delivery, so a delivery is never lost; a row that failed is the
 * dead-letter queue — the payload is still here, and it can be processed again by hand. Unique per company, provider and
 * the provider's own lead id, so one enquiry delivered twice (a retry, or by pull and by push) is one row; `received_count`
 * says how often it came.
 *
 * @property int $integration_connection_id
 * @property string $provider
 * @property string $provider_lead_id
 * @property string $via
 * @property InboundStatus $status
 * @property int|null $lead_id
 * @property int $attempts
 * @property int $received_count
 * @property array<string, mixed> $payload
 * @property string $payload_hash
 * @property string|null $error
 * @property Carbon|null $processed_at
 */";s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:49:"Illuminate\Database\Eloquent\Attributes\UsePolicy";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:58:"\App\Modules\Integrations\Policies\LeadApiLogPolicy::class";s:10:"attributes";a:6:{s:9:"startLine";i:35;s:7:"endLine";i:35;s:13:"startTokenPos";i:52;s:12:"startFilePos";i:1380;s:11:"endTokenPos";i:54;s:10:"endFilePos";i:1402;}}}}}s:9:"startLine";i:35;s:7:"endLine";i:62;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:34:"Illuminate\Database\Eloquent\Model";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:1:{i:0;s:51:"App\Modules\Shared\Models\Concerns\BelongsToCompany";}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:3:{s:5:"casts";a:20:{s:4:"name";s:5:"casts";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:42;s:7:"endLine";i:49;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:2;s:9:"namespace";s:31:"App\Modules\Integrations\Models";s:18:"declaringClassName";s:42:"App\Modules\Integrations\Models\LeadApiLog";s:21:"implementingClassName";s:42:"App\Modules\Integrations\Models\LeadApiLog";s:16:"currentClassName";s:42:"App\Modules\Integrations\Models\LeadApiLog";s:9:"aliasName";N;}s:10:"connection";a:20:{s:4:"name";s:10:"connection";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:48:"Illuminate\Database\Eloquent\Relations\BelongsTo";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:0:{}s:10:"docComment";s:54:"/** @return BelongsTo<IntegrationConnection, $this> */";s:9:"startLine";i:5