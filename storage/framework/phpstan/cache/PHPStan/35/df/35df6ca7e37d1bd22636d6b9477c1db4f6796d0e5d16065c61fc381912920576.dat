O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-c44a22905f5dc2fa486c5f2045d0d37a4ecde65c66151e7abfc7e7891cafbc1d";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:44:"App\Modules\Integrations\Services\LeadIntake";s:8:"filename";s:79:"C:/xampp/htdocs/industrial_crm/app/Modules/Integrations/Services/LeadIntake.php";}}s:9:"namespace";s:33:"App\Modules\Integrations\Services";s:4:"name";s:44:"App\Modules\Integrations\Services\LeadIntake";s:9:"shortName";s:10:"LeadIntake";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1504:"/**
 * Turns one stored delivery into what it should become. The same path for every provider, for a push, a pull and a retry by hand.
 *
 *  1. **Claim** the row (received or failed → processing) with one conditional UPDATE, so two workers never take the same
 *     delivery; a row stuck in `processing` for ten minutes (a worker died) can be claimed again.
 *  2. **Same mobile number as an open lead?** Then there is no second lead: a note is left on that lead, its owner is told,
 *     and the delivery is `linked`. (The check and the creation happen under a lock on the number, so two enquiries from one
 *     buyer arriving together make one lead.)
 *  3. Otherwise **create the lead** through LeadService — the same door as every other channel, so every lead rule holds — in
 *     the connection's branch, filed under the provider's standard source, owned by the connection's chosen person or left in
 *     the pool, and entered as the person who set the connection up.
 *
 * A marketplace lead may arrive without a mobile number, with only the placeholder name "IndiaMART Buyer", or with a foreign
 * number: it is kept, marked **incomplete**, and cannot be qualified until someone completes it. Things that are not valid (a
 * mobile number, an e-mail address, a PIN code) are left out of the lead and noted in its remarks, never allowed to sink it.
 *
 * Anything that goes wrong leaves the delivery `failed` with a redacted reason and its payload intact (the dead-letter queue).
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:47;s:7:"endLine";i:278;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:13:"STALE_MINUTES";a:12:{s:18:"declaringClassName";s:44:"App\Modules\Integrations\Services\LeadIntake";s:21:"implementingClassName";s:44:"App\Modules\Integrations\Services\LeadIntake";s:4:"name";s:13:"STALE_MINUTES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"10";s:10:"attributes";a:6:{s:9:"startLine";i:50;s:7:"endLine";i:50;s:13:"startTokenPos";i:142;s:12:"startFilePos";i:2757;s:11:"endTokenPos";i:142;s:10:"endFilePos";i:2758;}}s:10:"docComment";s:96:"/** A delivery claimed this long ago and still "processing" belongs to a worker that is gone. */";s:10:"attributes";a:0:{}s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:5;s:9:"endColumn";i:36;}}s:19:"immediateProperties";a:3:{s:9:"providers";a:16:{s:18:"declaringClassName";s:44:"App\Modules\Integrations\Services\LeadIntake";s:21:"implementingClassName";s:44:"App\Modules\Integrations\Services\LeadIntake";s:4:"name";s:9:"providers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:51:"App\Modules\Integrations\Providers\ProviderRegistry";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:53;s:7:"endLine";i:53;s:11:"startColumn";i:9;s:9:"endColumn";i:52;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"leads";a:16:{s:18:"declaringClassName";s:44:"App\Modules\Integrations\Services\LeadIntake";s:21:"implementingClassName";s:44:"App\Modules\Integrations\Services\LeadIntake";s:4:"name";s:5:"leads";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:36:"App\Modules\