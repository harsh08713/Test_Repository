O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-c831bd418db3b7416c1a80ba3831bd1d0836422ea8892315132e35f595b30283";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Sales\Services\SalesOrderAccess";s:8:"filename";s:78:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/SalesOrderAccess.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:43:"App\Modules\Sales\Services\SalesOrderAccess";s:9:"shortName";s:16:"SalesOrderAccess";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:919:"/**
 * Whose sales orders and invoices a person may see and work — the one rule the policies, the lists and the downloads share.
 *
 * An order belongs to the salesperson credited with it (`assigned_to`, set when it is made and never moved by a later hand-over of the lead:
 * targets count it for them). An invoice belongs to the same person as its order.
 *  - **Work** an order (change it, send it for approval, cancel it): that salesperson, the people who manage them, and holders of
 *    `sales.scope_all` (SalesScope).
 *  - **See** an order or an invoice: everyone who may work it; everyone holding **`sales_order.view_all`** (Accounts and Operations, who
 *    handle every order though they sell none); and, for an order, an approver for one waiting for their decision or one they decided.
 *
 * The company and branch boundaries are not decided here: every query already runs through the tenant scopes.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:108;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:5:"scope";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Sales\Services\SalesOrderAccess";s:21:"implementingClassName";s:43:"App\Modules\Sales\Services\SalesOrderAccess";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:33;s:9:"endColumn";i:66;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:9:"approvers";a:16:{s:18:"declaringClassName";s:43:"App\Modules\Sales\Services\SalesOrderAccess";s:21:"implementingClassName";s:43:"App\Modules\Sales\Services\SalesOrderAccess";s:4:"name";s:9:"approvers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:38:"App\Modules\CRM\Services\ApproverReach";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:69;s:9:"endColumn";i:109;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:8:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:5:"scope";a:13:{s:4:"name";s:5:"scope";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10: