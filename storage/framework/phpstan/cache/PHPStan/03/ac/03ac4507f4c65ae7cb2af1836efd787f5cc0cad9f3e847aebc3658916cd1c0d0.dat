O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-37231213c6ce64e53de15e32de5384abc68351af4143927da429a3e58eeddeda";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:42:"App\Modules\Finance\Services\Profitability";s:8:"filename";s:77:"C:/xampp/htdocs/industrial_crm/app/Modules/Finance/Services/Profitability.php";}}s:9:"namespace";s:28:"App\Modules\Finance\Services";s:4:"name";s:42:"App\Modules\Finance\Services\Profitability";s:9:"shortName";s:13:"Profitability";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1282:"/**
 * Profitability by product, brand or site — FORMULAS.md §2 `brand_profitability`, worked out in one place.
 *
 *   net_revenue   gross sales − discounts − approved returns   (issued invoices and approved returns dated in the period; tax excluded)
 *   cogs          cost of the invoiced lines − cost of the returned lines   (the cost copied onto the lines when they were made)
 *   gross_profit  net_revenue − cogs
 *   margin %      gross_profit ÷ net_revenue × 100; null when net revenue is 0
 *   actual_loss   validated actual loss of incidents of that item / brand / site (not duplicates, not rejected) — shown **beside** the profit, never
 *                 taken off it: the four loss values stay apart
 *
 * A line whose cost was not known adds nothing to the cost and is counted in `lines_without_cost`, so a row can say its profit is not complete.
 * Loss incidents with no item belong to the "No item" row of a product view and "No brand" of a brand view. **Industry**: a sale belongs to the industry of its
 * item (`items.industry_template_id`, "Unassigned" when none is set); a loss to the industry of its incident. Optional filters narrow every figure to one
 * industry and/or one branch. Everything runs through the tenant and branch scopes.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:125;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:10:"DIMENSIONS";a:12:{s:18:"declaringClassName";s:42:"App\Modules\Finance\Services\Profitability";s:21:"implementingClassName";s:42:"App\Modules\Finance\Services\Profitability";s:4:"name";s:10:"DIMENSIONS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:88:"['product' => 'Product', 'brand' => 'Brand', 'site' => 'Site', 'industry' => 'Industry']";s:10:"attributes";a:6:{s:9:"startLine";i:28;s:7:"endLine";i:28;s:13:"startTokenPos";i:50;s:12:"startFilePos";i:1580;s:11:"endTokenPos";i:77;s:10:"endFilePos";i:1667;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:119;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:4:{s:2:"by";a:20:{s:4:"name";s:2:"by";s:10:"parameters";a:5:{s:9:"dimension";a:13:{s:4:"name";s:9:"dimension";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:24;s:9:"endColumn";i:40;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"from";a:13:{s:4:"name";s:4:"from";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:22:"Carbon\CarbonInterface";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:43;s:9:"endColumn";i:63;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:2:"to";a:13:{s:4:"name";s:2:"to";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\Bette