 * Permission-matrix driven policy: every ability maps to `{form}.{action}`. Subclasses only declare their
 * form key. There is no blanket bypass for any role: Super Admin simply holds every permission.
 *
 * Two things must both hold for any action on a record:
 *   1. the user holds the permission; and
 *   2. the record is in the user's tenant (their companies and branches) — checked here as well as by the
 *      global scopes, so a record obtained by any other route (a model passed to a component, a job) is
 *      still refused.
 *
 * Approvable records that are pending or approved are locked against editing/deleting until they are
 * rejected or re-opened by the workflow.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:125;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:14:{s:4:"form";a:20:{s:4:"name";s:4:"form";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:71:"/** Permission form key, e.g. `item` for `item.view`, `item.edit`... */";s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:47;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:66;s:9:"namespace";s:27:"App\Modules\Shared\Policies";s:18:"declaringClassName";s:46:"App\Modules\Shared\Policies\BaseDocumentPolicy";s:21:"implementingClassName";s:46:"App\Modules\Shared\Policies\BaseDocumentPolicy";s:16:"currentClassName";s:46:"App\Modules\Shared\Policies\BaseDocumentPolicy";s:9:"aliasName";N;}s:6:"allows";a:20:{s:4:"name";s:6:"allows";s:10:"parameters";a:2:{s:4:"user";a:13:{s:4:"name";s:4:"user";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:15:"App\Models\User";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:30;s:11:"startColumn";i:31;s:9:"endColumn";i:40;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:6:"action";a:13:{s:4:"name";s:6:"action";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\Shared\Enums\PermissionAction";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"a