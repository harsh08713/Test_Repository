O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-65c95a1d33979436e3a7f05aa288c538934e46a0ca91ab201d8bff445433ff27";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:51:"App\Modules\Integrations\Providers\JustDialProvider";s:8:"filename";s:86:"C:/xampp/htdocs/industrial_crm/app/Modules/Integrations/Providers/JustDialProvider.php";}}s:9:"namespace";s:34:"App\Modules\Integrations\Providers";s:4:"name";s:51:"App\Modules\Integrations\Providers\JustDialProvider";s:9:"shortName";s:16:"JustDialProvider";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1115:"/**
 * Just Dial's lead feed — **push only**.
 *
 * What is known: Just Dial publishes no self-service developer API. A business gets its leads pushed to a web address of its
 * own when its Just Dial account manager switches that on (the integrations other CRMs offer all work this way: they give you
 * an address, you give it to Just Dial's team), or gets credentials for a pull API from the account manager. The record layout
 * below is the one such integrations commonly receive; it is tolerant — every field is optional, the lead id is the only thing
 * required — and it is **to be confirmed against the payload Just Dial actually sends your account**.
 *
 * Fields read: leadid, leadtype, prefix, name, mobile, phone, email, date, time, category, area, city, brancharea, pincode,
 * company, parentid, dncmobile / dncphone (the number is on the do-not-call register).
 *
 * There is nothing to pull, so `fetch()` says so; a pull adapter is added to this class if an account is given one.
 * Live verification is **pending** until Just Dial supplies the address configuration and a sample payload.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:147;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:1:{i:0;s:47:"App\Modules\Integrations\Providers\LeadProvider";}s:15:"traitClassNames";a:1:{i:0;s:56:"App\Modules\Integrations\Providers\Concerns\ReadsRecords";}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:15:{s:3:"key";a:20:{s:4:"name";s:3:"key";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:29;s:7:"endLine";i:32;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:34:"App\Modules\Integrations\Providers";s:18:"declaringClassName";s:51:"App\Modules\Integrations\Providers\JustDialProvider";s:21:"implementingClassName";s:51:"App\Modules\Integrations\Providers\JustDialProvider";s:16:"currentClassName";s:51:"App\Modules\Integrations\Providers\JustDialProvider";s:9:"aliasName";N;}s:5:"label";a:20:{s:4:"name";s:5:"label";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:34;s:7:"endLine";i:37;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:34:"App\Modules\Integrations\Providers";s:18:"declaringClassName";s:51:"App\Modules\Integrations\Providers\JustDialProvider";s:21:"implementingClassName";s:51:"App\Modules\Integrations\Providers\JustDialProvider";s:16:"currentClassName";s:51:"App\M