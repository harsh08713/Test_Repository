O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-d526118203953a9bb8bf759bcada8511a16a47042b1f216199bd042f5a2949a9";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:41:"App\Modules\Api\Http\Requests\DealRequest";s:8:"filename";s:76:"C:/xampp/htdocs/industrial_crm/app/Modules/Api/Http/Requests/DealRequest.php";}}s:9:"namespace";s:29:"App\Modules\Api\Http\Requests";s:4:"name";s:41:"App\Modules\Api\Http\Requests\DealRequest";s:9:"shortName";s:11:"DealRequest";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:550:"/**
 * A deal to make from a lead (POST) or to change (PATCH). Fields are flat; the lines are a list under `items`.
 *
 * On a change only the fields that are sent are changed. Sending `items` — or a customer — changes what the deal *is* (and is
 * refused once the deal is in approval or approved); sending only the close date, the probability or the remarks updates where
 * it stands, which an open deal always allows. Sending `items` replaces the lines: rows with an `id` are updated, rows without
 * are added, rows left out are removed.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:16;s:7:"endLine";i:76;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:40:"App\Modules\Api\Http\Requests\ApiRequest";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:6:"FIELDS";a:12:{s:18:"declaringClassName";s:41:"App\Modules\Api\Http\Requests\DealRequest";s:21:"implementingClassName";s:41:"App\Modules\Api\Http\Requests\DealRequest";s:4:"name";s:6:"FIELDS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:71:"['customer_ledger_id', 'expected_close_date', 'probability', 'remarks']";s:10:"attributes";a:6:{s:9:"startLine";i:19;s:7:"endLine";i:19;s:13:"startTokenPos";i:39;s:12:"startFilePos";i:892;s:11:"endTokenPos";i:50;s:10:"endFilePos";i:962;}}s:10:"docComment";s:137:"/** The deal fields a client may send; ids of company and branch, the number, the value, the stage and approvals are never among them. */";s:10:"attributes";a:0:{}s:9:"startLine";i:19;s:7:"endLine";i:19;s:11:"startColumn";i:5;s:9:"endColumn";i:99;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:3:{s:5:"rules";a:20:{s:4:"name";s:5:"rules";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:35:"/** @return array<string, mixed> */";s:9:"startLine";i:22;s:7:"endLine";i:42;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:29:"App\Modules\Api\Http\Requests";s:18:"declaringClassName";s:41:"App\Modules\Api\Http\Requests\DealRequest";s:21:"implementingClassName";s:41:"App\Modules\Api\Http\Requests\DealRequest";s:16:"currentClassName";s:41:"App\Modules\Api\Http\Requests\DealRequest";s:9:"aliasName";N;}s:10:"dealFields";a:20:{s:4:"name";s:10:"dealFields";s:10