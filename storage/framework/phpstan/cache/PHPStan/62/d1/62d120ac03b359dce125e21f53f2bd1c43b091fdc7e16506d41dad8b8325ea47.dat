O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-947901ee73b9e13129947ab8ba8651fcce6ae475cba8944baa8fa0ad7b261f8e";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:46:"App\Modules\Shared\Services\PermissionRegistry";s:8:"filename";s:81:"C:/xampp/htdocs/industrial_crm/app/Modules/Shared/Services/PermissionRegistry.php";}}s:9:"namespace";s:27:"App\Modules\Shared\Services";s:4:"name";s:46:"App\Modules\Shared\Services\PermissionRegistry";s:9:"shortName";s:18:"PermissionRegistry";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:675:"/**
 * Catalogue of every permission "form" (a screen / record type) and the actions that apply to it,
 * plus the default grants of each seeded role. The matrix UI and RolePermissionSeeder both read
 * from here, so a new module only has to add its forms in one place.
 *
 * Permission names are `{form}.{action}`, e.g. `item.edit`, `quotation.approve`.
 *
 * There is no implicit "Super Admin bypasses everything" rule. Super Admin is an ordinary role that the
 * seeder keeps granted with *every* permission, including the explicit, audited override permissions in
 * special() — so what a Super Admin can do is visible and can be reasoned about like any other role.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:18;s:7:"endLine";i:393;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:11:"SUPER_ADMIN";a:12:{s:18:"declaringClassName";s:46:"App\Modules\Shared\Services\PermissionRegistry";s:21:"implementingClassName";s:46:"App\Modules\Shared\Services\PermissionRegistry";s:4:"name";s:11:"SUPER_ADMIN";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:13:"'Super Admin'";s:10:"attributes";a:6:{s:9:"startLine";i:20;s:7:"endLine";i:20;s:13:"startTokenPos";i:30;s:12:"startFilePos";i:835;s:11:"endTokenPos";i:30;s:10:"endFilePos";i:847;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:20;s:7:"endLine";i:20;s:11:"startColumn";i:5;s:9:"endColumn";i:45;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:5:{s:5:"forms";a:20:{s:4:"name";s:5:"forms";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:98:"/** @return array<string, array{label: string, group: string, actions: list<PermissionAction>}> */";s:9:"startLine";i:23;s:7:"endLine";i:124;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:17;s:9:"namespace";s:27:"App\Modules\Shared\Services";s:18:"declaringClassName";s:46:"App\Modules\Shared\Services\PermissionRegistry";s:21:"implementingClassName";s:46:"App\Modules\Shared\Services\PermissionRegistry";s:16:"currentClassName";s:46:"App\Modules\Shared\Services\PermissionRegistry";s:9:"aliasName";N;}s:7:"special";a:20:{s:4:"name";s:7:"special";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data