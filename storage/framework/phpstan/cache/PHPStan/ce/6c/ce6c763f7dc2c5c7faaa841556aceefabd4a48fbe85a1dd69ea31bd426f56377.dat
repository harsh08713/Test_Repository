 * Who may do what to an item, stage by stage.
 *
 * Each department owns one stage and has its own permission for it: `item.manage_purchase_stage` (name, group,
 * units, tolerance, HSN, GST) and `item.manage_inventory_stage` (code, aliases, stock levels). Holding a stage
 * permission is not enough on its own — the item must also be *in* that stage and not locked by the approval.
 * Operations holds neither, so it can view and comment but every change is refused. Approving needs `item.approve`
 * and an item awaiting approval; who is designated is the approval engine's business.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:21;s:7:"endLine";i:121;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:46:"App\Modules\Shared\Policies\BaseDocumentPolicy";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:15:{s:4:"form";a:20:{s:4:"name";s:4:"form";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:23;s:7:"endLine";i:26;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:2;s:9:"namespace";s:28:"App\Modules\Masters\Policies";s:18:"declaringClassName";s:39:"App\Modules\Masters\Policies\ItemPolicy";s:21:"implementingClassName";s:39:"App\Modules\Masters\Policies\ItemPolicy";s:16:"currentClassName";s:39:"App\Modules\Masters\Policies\ItemPolicy";s:9:"aliasName";N;}s:12:"purchaseDesk";a:20:{s:4:"name";s:12:"purchaseDesk";s:10:"parameters";a:1:{s:4:"user";a:13:{s:4:"name";s:4:"user";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:15:"App\Models\User";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:28;s:7:"endLine";i:28;s:11:"startColumn";i:35;s:9:"endColumn";i:44;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:28;s:7:"endLine";i:31;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosu