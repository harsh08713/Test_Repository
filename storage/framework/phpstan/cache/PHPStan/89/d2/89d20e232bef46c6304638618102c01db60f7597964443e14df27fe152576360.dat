O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-cc3e31046a42fcb33484fe61ac67bdbc877fe3baedf5c86aca8ee9dfb38a5ef9";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\LeadScorer";s:8:"filename";s:70:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/LeadScorer.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:35:"App\Modules\CRM\Services\LeadScorer";s:9:"shortName";s:10:"LeadScorer";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1603:"/**
 * Scores a lead from its own record with fixed, explainable rules (brief 6.2: "configurable lead scoring based on explicit business signals such as source, response
 * history, requirement completeness, engagement and time since last contact"). **There is no AI here**: the same record always gives the same score, every point has a
 * sentence saying where it came from, and the company decides the weights (Company settings → Lead scoring). It is advice — nothing here moves a lead, changes an owner
 * or sends a message.
 *
 * Six signals, each earning up to its weight:
 *  - **source**       the company's percentage for the lead's source (a referral is worth more than a spreadsheet);
 *  - **completeness** six details present: mobile, e-mail, contact person, a real requirement, an address (PIN, street or city), an expected value;
 *  - **engagement**   conversations that reached the person (follow-ups done whose outcome counts as a contact): none 0, one 40 %, two 70 %, three or more 100 %;
 *                     follow-ups done that never reached anyone earn 10 %;
 *  - **recency**      days since the last contact (3 days or less 100 %, 7 → 75 %, 14 → 50 %, 30 → 25 %, older 0); a lead never contacted counts from the day it was entered, at half;
 *  - **stage**        New 0, Contacted ⅓, Qualified ⅔, Deal or Quotation all of it;
 *  - **value**        the expected value against the company's threshold: all of it at the threshold, half at half.
 *
 * score = points earned ÷ points available × 100, rounded. Hot / warm / cold are the company's two cut-offs.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:214;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:8:"settings";a:16:{s:18:"declaringClassName";s:35:"App\Modules\CRM\Services\LeadScorer";s:21:"implementingClassName";s:35:"App\Modules\CRM\Services\LeadScorer";s:4:"name";s:8:"settings";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Services\SettingsService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:33;s:9:"endColumn";i:74;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:13:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:8:"settings";a:13:{s:4:"name";s:8:"settings";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Modules\Shared\Services\SettingsService";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:33;s:9:"endColumn";i:74;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:5;s:9:"endColumn";i:78;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:24:"App\Modules\CRM\Services";s:18:"declaringClassName";s:35:"App\Modules\CRM\Services\LeadScorer";s:21:"implementingClassName";s:35:"App\Modules\CRM\Services\LeadScorer";s:16:"currentCl