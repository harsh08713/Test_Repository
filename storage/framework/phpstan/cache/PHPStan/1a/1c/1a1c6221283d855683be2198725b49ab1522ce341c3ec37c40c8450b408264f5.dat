O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-6bbaa77eb811012db40183238dee647565fff086982acf9a3f03aa9f533401c5";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:31:"App\Modules\Masters\Models\Item";s:8:"filename";s:66:"C:/xampp/htdocs/industrial_crm/app/Modules/Masters/Models/Item.php";}}s:9:"namespace";s:26:"App\Modules\Masters\Models";s:4:"name";s:31:"App\Modules\Masters\Models\Item";s:9:"shortName";s:4:"Item";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1661:"/**
 * The item master, filled in by three departments in turn:
 *
 *   1. Purchase   — name, group, base unit, unit conversions, PO tolerance, HSN and GST rate
 *   2. Inventory  — item code, alias names, stock levels per branch
 *   3. Approval   — Accounts by default (configurable per company); Operations may view and comment only
 *
 * `workflow_stage` says whose turn it is; `approval_status` is the shared approval engine's state. The two are
 * kept consistent *here*, whichever screen or service drives the engine (the item page, the approval inbox, a
 * future API): submitting moves the item to "awaiting approval", approving to "approved", and a rejection or
 * re-opening sends it back to the stage that was named (default: Inventory after a rejection, Purchase after a
 * re-opening). Every move is written to the item's stage history from the one place below, so no path can skip it.
 *
 * Only an approved, active item may be used by a transaction (see ItemLookup).
 *
 * @property string|null $code
 * @property string $name
 * @property string|null $description
 * @property int $item_group_id
 * @property int|null $brand_id
 * @property int|null $industry_template_id the industry the product belongs to (revenue by industry); null = unassigned
 * @property string $tracking none|batch
 * @property bool $has_expiry
 * @property int|null $shelf_life_days
 * @property string|null $standard_cost per base unit; what an invoice line takes as its cost
 * @property int $base_unit_id
 * @property string $po_tolerance_percent
 * @property string|null $hsn_code
 * @property string|null $gst_rate
 * @property ItemStage $workflow_stage
 */";s:10:"attributes";a:2:{i:0;a:3:{s:4:"name";s:48:"Illuminate\Database\Eloquent\Attributes\Fillable";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:186:"['code', 'name', 'description', 'item_group_id', 'brand_id', 'industry_template_id', 'base_unit_id', 'po_tolerance_percent', 'hsn_code', 'gst_rate', 'standard_cost', 'status', 'remarks']";s:10:"attributes";a:6:{s:9:"startLine";i:61;s:7:"endLine";i:61;s:13:"startTokenPos";i:132;s:12:"startFilePos";i:2827;s:11:"endTokenPos";i:170;s:10:"endFilePos";i:3012;}}}}i:1;a:3:{s:4:"name";s:49:"Illuminate\Database\Eloquent\Attributes\UsePolicy";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{i:0;a:2:{s:4:"code";s:47:"\App\Modules\Masters\Policies\ItemPolicy::class";s:10:"attributes";a:6:{s:9:"startLine";i:62;s:7:"endLine";i:62;s:13:"startTokenPos";i:177;s:12:"startFilePos";i:3028;s:11:"endTokenPos";i:179;s:10:"endFilePos";i:3044;}}}}}s:9:"startLine";i:61;s:7:"endLine";i:353;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:37:"App\Modules\Shared\Models\TenantModel";s:20:"implementsClassNames";a:1:{i:0;s:47:"App\Modules\Shared\Contracts\ApprovableDocument";}s:15:"traitClassNames";a:2:{i:0;s:45:"App\Modules\Shared\Models\Concerns\Approvable";i:1;s:57:"App\Modules\Shared\Models\Concerns\ValidatesParentCompany";}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:5:{s:10:"attributes";a:16:{s:18:"declaringClassName";s:31:"App\Modules\Masters\Models\Item";s:21:"implementingClassName";s:31:"App\Modules\Masters\Models\Item";s:4:"name";s:10:"attributes";s:9:"modifiers";i:2;s:4:"type";N;s:7:"default";a:2:{s:4:"code";s:134:"['status' => 'active', 'po_tolerance_percent' => 0, 'workflow_stage' => 'purchase_draft', 'tracking' => 'none', 'has_expiry' => false]";s:10:"attributes";a:6:{s:9:"startLine";i:67;s:7:"endLine";i:73;s:13:"startTokenPos";i:211;s:12:"startFilePos";i:3184;s:11:"endTokenPos";i:248;s:10:"endFilePos";i:3364;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:67;s:7:"endLi