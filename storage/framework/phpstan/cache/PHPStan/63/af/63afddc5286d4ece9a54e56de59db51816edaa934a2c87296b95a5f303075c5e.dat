O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-424a046a8cb242eafabae7b8b48b349536b42c49f8692d3732431e1b02d7954b";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:47:"App\Modules\Sales\Services\NetRevenueCalculator";s:8:"filename";s:82:"C:/xampp/htdocs/industrial_crm/app/Modules/Sales/Services/NetRevenueCalculator.php";}}s:9:"namespace";s:26:"App\Modules\Sales\Services";s:4:"name";s:47:"App\Modules\Sales\Services\NetRevenueCalculator";s:9:"shortName";s:20:"NetRevenueCalculator";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1181:"/**
 * Net revenue, cost of goods sold, gross profit and margin for a period — FORMULAS.md §2, version 1. The only place these are worked out, so
 * the dashboard, the reports and the exports (Phase L6) cannot disagree.
 *
 *   gross_sales   = Σ gross amount of the lines of issued invoices dated in the period
 *   discounts     = Σ discount of those lines
 *   returns       = Σ taxable value of **approved** returns and credit notes dated in the period (a draft, pending or rejected one counts for nothing)
 *   net_revenue   = gross_sales − discounts − returns
 *   cogs          = Σ cost of those invoice lines − Σ cost of the returned lines
 *   gross_profit  = net_revenue − cogs
 *   margin_pct    = null when net_revenue is 0, else gross_profit ÷ net_revenue × 100 (2 decimals, half up)
 *
 * Tax is left out of every figure. A cancelled invoice counts for nothing. A line with no known cost adds nothing to the cost, and is counted in
 * `lines_without_cost` so a report can say its profit is not complete — a missing cost is never read as zero. Everything runs through the
 * tenant scopes, so a person sees the company and branches they work in.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:81;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:2:{s:9:"forPeriod";a:20:{s:4:"name";s:9:"forPeriod";s:10:"parameters";a:3:{s:4:"from";a:13:{s:4:"name";s:4:"from";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:22:"Carbon\CarbonInterface";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:31;s:9:"endColumn";i:51;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:2:"to";a:13:{s:4:"name";s:2:"to";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:22:"Carbon\CarbonInterface";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:54;s:9:"endColumn";i:72;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:10:"locationId";a:13:{s:4:"name";s:10:"locationId";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:32;s:7:"endLine";i:32;s:13:"startTokenPos";i:67;s:12:"startFilePos";i:1785;s:11:"endTokenPos";i:67;s:10:"endFilePos";i:1788;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s