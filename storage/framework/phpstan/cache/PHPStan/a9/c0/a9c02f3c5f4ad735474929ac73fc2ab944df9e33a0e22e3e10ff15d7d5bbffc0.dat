O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.3.35-b28eb1b18e8837677014c3f254802cc63a27c51ce0069f6eb3ee4f649d666c94";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\LeadAccess";s:8:"filename";s:70:"C:/xampp/htdocs/industrial_crm/app/Modules/CRM/Services/LeadAccess.php";}}s:9:"namespace";s:24:"App\Modules\CRM\Services";s:4:"name";s:35:"App\Modules\CRM\Services\LeadAccess";s:9:"shortName";s:10:"LeadAccess";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1051:"/**
 * Whose leads a person may see and work — the one rule the policy, the lists, the transfer service and (later) the API share.
 *
 * **Work** (edit, move between stages, hand over):
 *  - a lead assigned to somebody: that person, the people who manage them, and holders of `sales.scope_all` (SalesScope);
 *  - a lead assigned to nobody (the pool): whoever entered it, and anyone who may hand leads out (`lead.assign`).
 *
 * **See** (open it, follow it up): everyone who may work it, plus anyone who has a *planned* follow-up on it — a
 * tele-caller asked to ring somebody else's lead has to be able to open it. That reach lasts as long as the follow-up is
 * planned and no longer. And an approver may open an inquiry from an existing customer that is waiting for their decision
 * (or that they have decided): ApproverReach.
 *
 * The company and branch boundaries are not decided here: every lead and follow-up query already runs through the tenant
 * scopes, so a follow-up never opens a lead in a branch the person does not work in.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:161;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:5:"scope";a:16:{s:18:"declaringClassName";s:35:"App\Modules\CRM\Services\LeadAccess";s:21:"implementingClassName";s:35:"App\Modules\CRM\Services\LeadAccess";s:4:"name";s:5:"scope";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:29;s:11:"startColumn";i:33;s:9:"endColumn";i:66;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:9:"approvers";a:16:{s:18:"declaringClassName";s:35:"App\Modules\CRM\Services\LeadAccess";s:21:"implementingClassName";s:35:"App\Modules\CRM\Services\LeadAccess";s:4:"name";s:9:"approvers";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:38:"App\Modules\CRM\Services\ApproverReach";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:29;s:11:"startColumn";i:69;s:9:"endColumn";i:109;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:8:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:5:"scope";a:13:{s:4:"name";s:5:"scope";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Modules\CRM\Services\SalesScope";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:1;s:10:"attribute